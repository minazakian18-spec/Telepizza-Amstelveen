---
import { site, fullAddress } from '../data/site';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/fraunces/latin-600-italic.css';
import f1 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import f2 from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
const fonts = [f1, f2];
interface Crumb { name: string; path: string }
interface Props { title: string; description: string; crumbs?: Crumb[]; schema?: object[]; overlay?: boolean; image?: string }
const { title, description, crumbs = [], schema = [], overlay = false, image = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const restaurant: any = {
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  '@id': site.url + '/#restaurant',
  name: site.name,
  url: site.url + '/',
  image: site.url + '/images/restaurant-binnen.webp',
  priceRange: '€€',
  servesCuisine: ['Italiaans', 'Pizza', 'Pasta', 'Grill', 'Shoarma', 'Kapsalon', 'Burgers', 'Halal'],
  hasMenu: site.url + '/menu-italiaans-restaurant-amstelveen/',
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.postalCode, addressLocality: site.city, addressCountry: site.country },
  areaServed: ['Amstelveen', 'Amsterdam-Zuid', 'Buitenveldert'],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.value, reviewCount: site.rating.count, bestRating: 5 },
  potentialAction: { '@type': 'OrderAction', target: site.orderUrl },
};
if (site.phone) restaurant.telephone = site.phone;
if (site.email) restaurant.email = site.email;
if (site.geo) restaurant.geo = { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng };
if (site.foundingYear) restaurant.foundingDate = String(site.foundingYear);
if (site.reserveUrl) restaurant.acceptsReservations = site.reserveUrl;
if (site.sameAs.length) restaurant.sameAs = site.sameAs;
if (site.hours.length) restaurant.openingHoursSpecification = site.hours.map(h => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schema, opens: h.open, closes: h.close }));

const all = [{ name: 'Home', path: '/' }, ...crumbs];
const breadcrumb = crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, site.url).href })),
} : null;
const ld = [restaurant, breadcrumb, ...schema].filter(Boolean);

const nav = [
  ['/menu-italiaans-restaurant-amstelveen/', 'Menu'],
  ['/pizza-amstelveen/', 'Pizza'],
  ['/pasta-amstelveen/', 'Pasta'],
  ['/kapsalon-amstelveen/', 'Kapsalon'],
  ['/steak-grill-amstelveen/', 'Grill'],
  ['/bezorgen-amstelveen/', 'Bezorgen'],
  ['/catering-italiaans-restaurant-amstelveen/', 'Catering'],
  ['/over-ons-italiaans-restaurant-amstelveen/', 'Over ons'],
  ['/contact-route/', 'Contact'],
];
const path = Astro.url.pathname;
const phoneIco = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z';
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#120c0a" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{fonts.map(f => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
<meta property="og:type" content="website" />
<meta property="og:locale" content="nl_NL" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(image, site.url).href} />
<meta name="twitter:card" content="summary_large_image" />
{ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
<slot name="head" />
<style is:global>
:root{
  --bg:#120c0a;--bg2:#1b1310;--card:#231915;--line:rgba(255,236,214,.12);
  --ink:#fff8ef;--muted:#d6c8b8;--cream:#f8f1e7;--cream2:#efe4d4;--dark:#1d1410;--dmuted:#5b4a3e;
  --red:#d9302a;--red2:#f04a37;--gold:#f3b744;--green:#2e8b57;
  --serif:Fraunces,Georgia,"Times New Roman",serif;--sans:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --r:18px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;font:400 17px/1.7 var(--sans);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}
@media(min-width:900px){body{font-size:18px}}
a{color:inherit}
img,video{max-width:100%;display:block}
h1,h2,h3{font-family:var(--serif);font-weight:600;line-height:1.08;letter-spacing:-.015em;text-wrap:balance}
h1{font-size:clamp(2.5rem,6.5vw,4.6rem);margin:20px 0 16px}
h2{font-size:clamp(2rem,4.6vw,3.3rem);margin:0 0 18px}
h3{font-size:1.4rem;margin:0 0 6px}
em.hl{font-style:italic;color:var(--gold)}
.wrap{max-width:1220px;margin:0 auto;padding:0 16px}
@media(min-width:700px){.wrap{padding:0 28px}}
.sec{padding:88px 0}
.sec.alt{background:var(--bg2)}
.sec.light{background:var(--cream);color:var(--dark)}
.sec.light p,.sec.light li{color:var(--dmuted)}
.sec.light h2,.sec.light h3{color:var(--dark)}
.center{text-align:center}
.center p{margin-left:auto;margin-right:auto}
p{max-width:68ch;color:var(--muted)}
.eyebrow{display:inline-block;font:600 .8rem/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin:0 0 14px}
.sec.light .eyebrow{color:#a5300f}
/* header */
.top{position:sticky;top:0;z-index:50;background:rgba(18,12,10,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top.overlay{position:fixed;left:0;right:0;background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,0));border-color:transparent;backdrop-filter:none;transition:background .3s}
.top.overlay.solid{background:rgba(18,12,10,.94);border-color:var(--line);backdrop-filter:blur(10px)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:72px}
.logo{display:flex;flex-direction:column;text-decoration:none;line-height:1}
.logo b{font:600 1.75rem/1 var(--serif);letter-spacing:-.02em}
.logo b i{color:var(--red2);font-style:italic}
.logo small{white-space:nowrap;font-size:.68rem;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-top:5px}
.menu{display:none}
.menu ul{display:flex;align-items:center;gap:2px;list-style:none;margin:0;padding:0}
.menu a{display:inline-flex;align-items:center;min-height:44px;padding:0 10px;white-space:nowrap;text-decoration:none;font-size:.92rem;font-weight:600;border-radius:999px}
.menu a:hover,.menu a[aria-current]{background:rgba(255,255,255,.08)}
.hcta{display:flex;align-items:center;gap:8px}
.burger{position:relative}
.burger summary{list-style:none;display:grid;place-items:center;width:46px;height:46px;border-radius:999px;border:1px solid var(--line);cursor:pointer}
.burger summary::-webkit-details-marker{display:none}
.burger summary span,.burger summary span::before,.burger summary span::after{display:block;width:18px;height:2px;background:#fff;position:relative;content:""}
.burger summary span::before{position:absolute;top:-6px}.burger summary span::after{position:absolute;top:6px}
.burger[open] .panel{display:block}
.panel{display:none;position:fixed;left:0;right:0;top:72px;bottom:0;background:var(--bg);padding:20px 16px 120px;overflow:auto}
.panel a{display:block;padding:14px 4px;border-bottom:1px solid var(--line);font:600 1.5rem/1.2 var(--serif);text-decoration:none}
@media(min-width:1180px){.menu{display:block}.burger{display:none}}
/* buttons */
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
.center .btns{justify-content:center}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:12px 26px;border-radius:999px;border:1.5px solid rgba(255,255,255,.55);background:rgba(0,0,0,.25);color:#fff;font:600 1rem/1 var(--sans);text-decoration:none;transition:transform .15s,background .15s,border-color .15s}
.btn:hover,.btn:focus-visible{transform:translateY(-2px);border-color:#fff;background:rgba(255,255,255,.1)}
.btn.primary{background:var(--red);border-color:var(--red);box-shadow:0 10px 30px rgba(217,48,42,.35)}
.btn.primary:hover{background:#b8231e;border-color:#b8231e}
.btn.gold{background:var(--gold);border-color:var(--gold);color:#1d1410}
.btn.sm{min-height:42px;padding:8px 18px;font-size:.92rem}
.sec.light .btn:not(.primary):not(.gold){color:var(--dark);border-color:rgba(29,20,16,.4);background:transparent}
.ico{width:20px;height:20px;fill:currentColor;flex:none}
.flag{display:flex;width:120px;height:5px;border-radius:9px;overflow:hidden}
.center .flag{margin:0 auto}
.flag i{flex:1}.flag i:nth-child(1){background:#009246}.flag i:nth-child(2){background:#fff}.flag i:nth-child(3){background:#ce2b37}
/* subpage hero */
.phero{position:relative;padding:56px 0 40px;background:radial-gradient(1200px 400px at 80% -10%,rgba(217,48,42,.22),transparent),var(--bg)}
.lead{font-size:1.2rem;color:#eadfd2}
.crumbs{font-size:.88rem;color:var(--muted);padding-top:18px}
.crumbs ol{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0}
.crumbs li+li::before{content:"›";margin-right:6px}
main .wrap>h2,main section>h2{margin-top:56px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:22px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:24px}
.card h2,.card h3{margin-top:0}
.sec.light .card{background:#fff;border-color:rgba(29,20,16,.08);box-shadow:0 10px 30px rgba(60,30,10,.06)}
table{border-collapse:collapse;width:100%}
td,th{text-align:left;padding:14px 8px;border-bottom:1px solid var(--line);vertical-align:top}
td span{color:var(--muted)}
details{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 20px;margin:12px 0}
summary{font-weight:600;cursor:pointer}
.sec.light details{background:#fff;border-color:rgba(29,20,16,.1)}
main>.wrap{padding-bottom:72px}
.prose p,.prose li{color:var(--muted)}
.prose h2{font-size:clamp(1.7rem,3.4vw,2.4rem)}
/* dish card */
.dishes{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.dish{position:relative;background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
.dish .im{aspect-ratio:7/5;background:#f4ede3;overflow:hidden}
.dish img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.dish:hover img{transform:scale(1.05)}
.dish .tx{padding:16px 18px 18px;display:flex;flex-direction:column;flex:1}
.dish h3{font-size:1.2rem}
.dish p{font-size:.92rem;margin:0 0 12px;line-height:1.5}
.dish .row{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px}
.price{font:600 1.25rem/1 var(--serif);color:var(--gold)}
.tag{position:absolute;top:12px;left:12px;background:var(--red);color:#fff;font:600 .72rem/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;padding:7px 10px;border-radius:999px}
.sec.light .dish{background:#fff;border-color:rgba(29,20,16,.08)}
.sec.light .price{color:#a5300f}
/* CTA band + footer */
.band{position:relative;text-align:center;padding:96px 0;background:linear-gradient(rgba(18,12,10,.78),rgba(18,12,10,.88)),url(/images/restaurant-binnen.webp) center/cover}
.band p{color:#eadfd2}
footer{background:#0b0706;border-top:1px solid var(--line);padding:64px 0 120px;font-size:.95rem}
@media(min-width:900px){footer{padding-bottom:48px}}
footer .fg{display:grid;gap:32px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
footer h2{font:600 1.15rem/1.2 var(--serif);margin:0 0 12px}
footer p{margin:0}
footer ul{list-style:none;margin:0;padding:0;columns:2}
footer li a{display:inline-block;padding:4px 0;color:var(--muted);text-decoration:none}
footer li a:hover{color:#fff}
footer .legal{margin-top:40px;padding-top:20px;border-top:1px solid var(--line);color:var(--muted);font-size:.85rem}
/* mobile action bar */
.mbar{position:fixed;left:10px;right:10px;bottom:10px;z-index:60;display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:8px;padding:8px;background:rgba(18,12,10,.94);backdrop-filter:blur(10px);border:1px solid var(--line);border-radius:999px;box-shadow:0 12px 40px rgba(0,0,0,.5)}
.mbar a{display:flex;align-items:center;justify-content:center;gap:6px;min-height:46px;border-radius:999px;text-decoration:none;font-weight:600;font-size:.92rem}
.mbar a.o{background:var(--red)}
@media(min-width:900px){.mbar{display:none}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<header class:list={['top', { overlay }]} id="top"><div class="wrap">
  <a class="logo" href="/"><b>Tele<i>pizza</i></b><small>Amstelveen · sinds 1984</small></a>
  <nav class="menu" aria-label="Hoofdmenu"><ul>
    {nav.map(([h, t]) => <li><a href={h} aria-current={path === h ? 'page' : undefined}>{t}</a></li>)}
  </ul></nav>
  <div class="hcta">
    <a class="btn primary sm" href={site.orderUrl!} rel="noopener">Bestel online</a>
    <details class="burger"><summary aria-label="Menu openen"><span></span></summary>
      <nav class="panel" aria-label="Mobiel menu">
        <a href="/">Home</a>
        {nav.map(([h, t]) => <a href={h}>{t}</a>)}
        <a href="/veelgestelde-vragen/">Veelgestelde vragen</a>
        <div class="btns"><a class="btn primary" href={site.orderUrl!} rel="noopener">Bestel online</a><a class="btn" href={site.reserveUrl!} rel="noopener">Reserveer een tafel</a></div>
      </nav>
    </details>
  </div>
</div></header>
<main id="inhoud">
{crumbs.length > 0 && (
  <nav class="crumbs wrap" aria-label="Kruimelpad"><ol>
    {all.map((c, i) => <li>{i < all.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
  </ol></nav>
)}
<slot />
<section class="band">
  <div class="wrap">
    <p class="eyebrow">Reserveren bij de beste</p>
    <h2>Jouw tafel staat klaar</h2>
    <p class="center">Italiaans restaurant in Amstelveen, al sinds 1984. Reserveer online, bel ons of bestel direct voor afhalen en bezorgen.</p>
    <div class="btns" style="justify-content:center">
      <a class="btn primary" href={site.reserveUrl!} rel="noopener">Reserveer een tafel</a>
      <a class="btn" href={site.orderUrl!} rel="noopener">Bestel online</a>
      <a class="btn" href={'tel:' + site.phone}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIco}/></svg>{site.phoneDisplay}</a>
    </div>
  </div>
</section>
</main>
<footer><div class="wrap">
  <div class="fg">
    <div><a class="logo" href="/"><b>Tele<i>pizza</i></b><small>Amstelveen · sinds 1984</small></a>
      <p style="margin-top:16px">Italiaans restaurant, pizzeria en grill aan de Amsterdamseweg. Eten in het restaurant, afhalen of bezorgen. Al ons vlees is halal.</p></div>
    <div><h2>Adres & contact</h2><p>{fullAddress}<br />
      <a href={'tel:' + site.phone}>{site.phoneDisplay}</a><br />
      <a href={'mailto:' + site.email}>{site.email}</a><br />
      <a href={site.mapsUrl}>Route plannen</a></p></div>
    <div><h2>Openingstijden</h2><p>Maandag: gesloten<br />{site.hours.map(h => <span>{h.day}: {h.open}–{h.close}<br /></span>)}</p></div>
    <div><h2>Ontdek</h2><ul>
      <li><a href="/menu-italiaans-restaurant-amstelveen/">Menu</a></li>
      <li><a href="/pizza-amstelveen/">Pizza</a></li>
      <li><a href="/pizza-soorten/">Pizzasoorten</a></li>
      <li><a href="/pasta-amstelveen/">Pasta</a></li>
      <li><a href="/kapsalon-amstelveen/">Kapsalon</a></li>
      <li><a href="/steak-grill-amstelveen/">Steaks & grill</a></li>
      <li><a href="/halal-restaurant-amstelveen/">Halal</a></li>
      <li><a href="/laat-open-amstelveen/">Laat open</a></li>
      <li><a href="/restaurant-amstelveen/">Restaurant</a></li>
      <li><a href="/bezorgen-amstelveen/">Bezorgen</a></li>
      <li><a href="/catering-bedrijven-amstelveen/">Catering</a></li>
      <li><a href="/veelgestelde-vragen/">FAQ</a></li>
    </ul></div>
  </div>
  <p class="legal">© {new Date().getFullYear()} {site.name} · <a href="https://www.instagram.com/telepizza_nl/" rel="noopener">Instagram</a> · <a href="https://www.tiktok.com/@telepizza_nl" rel="noopener">TikTok</a></p>
</div></footer>
<nav class="mbar" aria-label="Snelle acties">
  <a href={'tel:' + site.phone}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIco}/></svg>Bel</a>
  <a class="o" href={site.orderUrl!} rel="noopener">Bestel online</a>
  <a href={site.reserveUrl!} rel="noopener">Reserveer</a>
</nav>
{overlay && <script is:inline>(function(){var h=document.getElementById('top');function f(){h.classList.toggle('solid',scrollY>40)}addEventListener('scroll',f,{passive:true});f();})();</script>}
</body>
</html>
