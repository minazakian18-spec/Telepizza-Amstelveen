---
import { site, fullAddress } from '../data/site';
interface Crumb { name: string; path: string }
interface Props { title: string; description: string; crumbs?: Crumb[]; schema?: object[] }
const { title, description, crumbs = [], schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const restaurant: any = {
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  '@id': site.url + '/#restaurant',
  name: site.name,
  url: site.url + '/',
  servesCuisine: ['Pizza', 'Italiaans', 'Pasta', 'Shoarma'],
  hasMenu: site.url + '/menu-italiaans-restaurant-amstelveen/',
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.postalCode, addressLocality: site.city, addressCountry: site.country },
  areaServed: 'Amstelveen',
};
if (site.phone) restaurant.telephone = site.phone;
if (site.email) restaurant.email = site.email;
if (site.geo) restaurant.geo = { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng };
if (site.foundingYear) restaurant.foundingDate = String(site.foundingYear);
if (site.reserveUrl) restaurant.acceptsReservations = site.reserveUrl;
if (site.sameAs.length) restaurant.sameAs = site.sameAs;
if (site.hours.length) restaurant.openingHoursSpecification = site.hours.map(h => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schema, opens: h.open, closes: h.close }));

const all = [{ name: 'Home', path: '/' }, ...crumbs];
const breadcrumb = crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, site.url).href })),
} : null;
const ld = [restaurant, breadcrumb, ...schema].filter(Boolean);

const nav = [
  ['/menu-italiaans-restaurant-amstelveen/', 'Menu'],
  ['/bezorgen-amstelveen/', 'Bezorgen'],
  ['/catering-italiaans-restaurant-amstelveen/', 'Catering'],
  ['/over-ons-italiaans-restaurant-amstelveen/', 'Over ons'],
  ['/contact-route/', 'Contact'],
];
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#b3261e" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="nl_NL" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={site.url + '/og.png'} />
<meta name="twitter:card" content="summary_large_image" />
{ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
<style is:global>
:root{--red:#b3261e;--red-dark:#8c1d17;--green:#1e6b3a;--ink:#1d1b1a;--muted:#4a4542;--bg:#fffaf3;--card:#fff;--line:#eadfce}
*{box-sizing:border-box}
body{margin:0;font:17px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--bg)}
a{color:var(--red-dark)}
.wrap{max-width:1040px;margin:0 auto;padding:0 16px}
header.top{background:var(--red);color:#fff}
header.top .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;padding-top:10px;padding-bottom:10px}
.logo{color:#fff;font-weight:800;font-size:1.25rem;text-decoration:none}
header nav ul{display:flex;flex-wrap:wrap;gap:4px 16px;list-style:none;margin:0;padding:0}
header nav a{color:#fff;text-decoration:none;font-weight:600;display:inline-block;padding:8px 0}
header nav a:hover,header nav a:focus{text-decoration:underline}
.crumbs{font-size:.9rem;color:var(--muted);padding-top:12px}
.crumbs ol{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0}
.crumbs li+li::before{content:"›";margin-right:6px}
main{padding-bottom:48px}
h1{font-size:clamp(1.8rem,5vw,2.6rem);line-height:1.15;margin:24px 0 12px}
h2{font-size:1.5rem;margin:36px 0 10px}
h3{margin:20px 0 6px}
.hero{background:linear-gradient(135deg,#fff3e0,#ffe2d6);border-bottom:1px solid var(--line);padding:24px 0 32px}
.lead{font-size:1.15rem;color:var(--muted);max-width:60ch}
.btns{display:flex;flex-wrap:wrap;gap:12px;margin-top:16px}
.btn{display:inline-block;padding:12px 20px;border-radius:999px;background:var(--red);color:#fff;font-weight:700;text-decoration:none;min-height:48px}
.btn.alt{background:var(--green)}
.btn:hover,.btn:focus{background:var(--red-dark)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.card h3{margin-top:0}
.todo{background:#fff4c2;border:1px dashed #a07a00;color:#4d3a00;padding:10px 14px;border-radius:10px;font-size:.95rem}
table{border-collapse:collapse;width:100%}
td,th{text-align:left;padding:8px;border-bottom:1px solid var(--line)}
details{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 16px;margin:10px 0}
summary{font-weight:700;cursor:pointer}
footer{background:#2a2523;color:#f3ebe3;padding:32px 0;font-size:.95rem}
footer a{color:#ffd9a8}
footer .grid{margin-top:0}
</style>
<!-- Google Analytics 4 met Consent Mode v2 (standaard geweigerd tot toestemming) -->
<script is:inline>
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});
try{if(localStorage.getItem('tp_consent')==='yes'){gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});}}catch(e){}
gtag('js',new Date());gtag('config','G-K7G8XYQZY4');
</script>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K7G8XYQZY4"></script>
</head>
<body>
<header class="top"><div class="wrap">
  <a class="logo" href="/">🍕 Telepizza Amstelveen</a>
  <nav aria-label="Hoofdmenu"><ul>{nav.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul></nav>
</div></header>
{crumbs.length > 0 && (
  <nav class="crumbs wrap" aria-label="Kruimelpad"><ol>
    {all.map((c, i) => <li>{i < all.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
  </ol></nav>
)}
<main id="inhoud"><slot /></main>
<footer><div class="wrap grid">
  <div>
    <strong>{site.name}</strong><br />{fullAddress}<br />
    {site.phone && <a href={'tel:' + site.phone}>{site.phoneDisplay}</a>}<br />
    {site.email && <a href={'mailto:' + site.email}>{site.email}</a>}<br />
    <a href="https://www.instagram.com/telepizza_nl/" rel="noopener">Instagram</a> · <a href="https://www.tiktok.com/@telepizza_nl" rel="noopener">TikTok</a>
  </div>
  <div>
    <strong>Pagina's</strong><br />
    <a href="/pizza-amstelveen/">Pizza</a> · <a href="/pasta-amstelveen/">Pasta</a> · <a href="/pizza-soorten/">Pizzasoorten</a> · <a href="/restaurant-amstelveen/">Restaurant</a> · <a href="/catering-bedrijven-amstelveen/">Catering bedrijven</a> · <a href="/veelgestelde-vragen/">Veelgestelde vragen</a>
  </div>
  <div><strong>Openingstijden</strong><br />Maandag: gesloten<br />
    {site.hours.length ? site.hours.map(h => <span>{h.day}: {h.open}–{h.close}<br /></span>) : <span>Zie Google Maps voor actuele tijden.</span>}
  </div>
</div></footer>
<div id="tp-cookie" hidden style="position:fixed;left:12px;right:12px;bottom:12px;z-index:999;max-width:560px;margin:0 auto;background:#fff;border:1px solid #eadfce;border-radius:12px;box-shadow:0 6px 24px rgba(0,0,0,.15);padding:14px 16px;font-size:15px">
<p style="margin:0 0 10px">We gebruiken cookies van Google Analytics om te zien hoe onze site gebruikt wordt. Akkoord?</p>
<button type="button" data-c="yes" style="background:#b3261e;color:#fff;border:0;border-radius:8px;padding:8px 16px;font-weight:700;cursor:pointer">Akkoord</button>
<button type="button" data-c="no" style="background:none;border:1px solid #ccc;border-radius:8px;padding:8px 16px;margin-left:8px;cursor:pointer">Weigeren</button>
</div>
<script is:inline>
(function(){
var b=document.getElementById('tp-cookie'),v=null;
try{v=localStorage.getItem('tp_consent');}catch(e){}
if(!v&&b)b.hidden=false;
if(b)b.addEventListener('click',function(e){var c=e.target.getAttribute&&e.target.getAttribute('data-c');if(!c)return;
try{localStorage.setItem('tp_consent',c);}catch(e){}
if(c==='yes')gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});
b.hidden=true;});
// Conversies: klik op bestellen (Sitedish/Thuisbezorgd/Uber Eats) of reserveren (TheFork)
document.addEventListener('click',function(e){
var a=e.target.closest&&e.target.closest('a[href]');if(!a)return;var h=a.href;
if(/sitedish|thuisbezorgd|ubereats/i.test(h))gtag('event','bestellen',{link_url:h,transport_type:'beacon'});
else if(/thefork/i.test(h))gtag('event','reserveren',{link_url:h,transport_type:'beacon'});
else if(/^tel:/i.test(h))gtag('event','bellen',{link_url:h,transport_type:'beacon'});
},true);
})();
</script>
</body>
</html>
