---
import { site, fullAddress } from '../data/site';
import { langs, langInfo, ui, pathFor, type Lang, type PageKey } from '../i18n/ui';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-900.css';
import '../styles/theme.css';
import f1 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import f2 from '@fontsource/archivo/files/archivo-latin-800-normal.woff2?url';
const fonts = [f1, f2];
interface Crumb { name: string; path: string }
interface Props { title: string; description: string; crumbs?: Crumb[]; schema?: object[]; overlay?: boolean; image?: string; lang?: Lang; page?: PageKey }
const { title, description, crumbs = [], schema = [], overlay = false, image = '/og.png', lang = 'nl', page } = Astro.props;
const t = ui[lang];
const info = langInfo[lang];
// Pagina's die in alle talen bestaan linken naar hun vertaling; andere pagina's naar de homepage van die taal.
const alternates = langs.map(l => ({ l, href: pathFor(l, page ?? 'home') }));
const canonical = new URL(Astro.url.pathname, site.url).href;

const restaurant: any = {
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  '@id': site.url + '/#restaurant',
  name: site.name,
  url: site.url + '/',
  image: site.url + '/images/restaurant-binnen.webp',
  priceRange: '€€',
  servesCuisine: ['Italiaans', 'Pizza', 'Pasta', 'Grill', 'Shoarma', 'Kapsalon', 'Burgers', 'Halal'],
  hasMenu: site.url + '/menu-italiaans-restaurant-amstelveen/',
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.postalCode, addressLocality: site.city, addressCountry: site.country },
  areaServed: ['Amstelveen', 'Amsterdam-Zuid', 'Buitenveldert'],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.value, reviewCount: site.rating.count, bestRating: 5 },
  potentialAction: { '@type': 'OrderAction', target: site.orderUrl },
};
if (site.phone) restaurant.telephone = site.phone;
if (site.email) restaurant.email = site.email;
if (site.geo) restaurant.geo = { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng };
if (site.foundingYear) restaurant.foundingDate = String(site.foundingYear);
if (site.reserveUrl) restaurant.acceptsReservations = site.reserveUrl;
if (site.sameAs.length) restaurant.sameAs = site.sameAs;
if (site.hours.length) restaurant.openingHoursSpecification = site.hours.map(h => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schema, opens: h.open, closes: h.close }));

const all = [{ name: t.home, path: pathFor(lang, 'home') }, ...crumbs];
const breadcrumb = crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, site.url).href })),
} : null;
const ld = [restaurant, breadcrumb, ...schema].filter(Boolean);

const nav: [string, string][] = lang === 'nl'
  ? [[pathFor('nl', 'menu'), t.nav.menu], [pathFor('nl', 'catering'), t.nav.catering], [pathFor('nl', 'about'), t.nav.about], ['/bezorgen-amstelveen/', t.nav.delivery], [pathFor('nl', 'contact'), t.nav.contact]]
  : (['menu', 'catering', 'about', 'contact'] as PageKey[]).map(k => [pathFor(lang, k), t.nav[k]]);
const path = Astro.url.pathname;
const phoneIco = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z';
---
<!doctype html>
<html lang={lang} dir={info.dir}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#fbf3e6" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{fonts.map(f => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
<meta property="og:type" content="website" />
<meta property="og:locale" content={info.og} />
{page && alternates.map(a => <link rel="alternate" hreflang={a.l} href={new URL(a.href, site.url).href} />)}
{page && <link rel="alternate" hreflang="x-default" href={new URL(pathFor('nl', page), site.url).href} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(image, site.url).href} />
<meta name="twitter:card" content="summary_large_image" />
{ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
<slot name="head" />
</head>
<body>
<header class:list={['top', { overlay }]} id="top"><div class="wrap">
  <a class="logo" href={pathFor(lang, 'home')}><b>Tele<i>pizza</i></b><small>{t.since}</small></a>
  <nav class="menu" aria-label="Hoofdmenu"><ul>
    {nav.map(([h, label]) => <li><a href={h} aria-current={path === h ? 'page' : undefined}>{label}</a></li>)}
  </ul></nav>
  <div class="hcta">
    <details class="lng"><summary title={t.language}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-2.9a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16zM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.4 6.7 8 8zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z"/></svg><span>{lang.toUpperCase()}</span></summary>
      <ul>{alternates.map(a => <li><a href={a.href} hreflang={a.l} lang={a.l} aria-current={a.l === lang ? 'true' : undefined}>{langInfo[a.l].name}</a></li>)}</ul>
    </details>
    <a class="btn primary sm hide-s" href={site.reserveUrl!} rel="noopener">{t.reserve}</a>
    <details class="burger"><summary aria-label="Menu openen"><span></span></summary>
      <nav class="panel" aria-label="Mobiel menu">
        <a href={pathFor(lang, 'home')}>{t.nav.home}</a>
        {nav.map(([h, label]) => <a href={h}>{label}</a>)}
        {lang === 'nl' && <a href="/veelgestelde-vragen/">Veelgestelde vragen</a>}
        <div class="btns"><a class="btn primary" href={site.reserveUrl!} rel="noopener">{t.reserve}</a><a class="btn" href={site.orderUrl!} rel="noopener">{t.order}</a></div>
      </nav>
    </details>
  </div>
</div></header>
<main id="inhoud">
{crumbs.length > 0 && (
  <nav class="crumbs wrap" aria-label="Kruimelpad"><ol>
    {all.map((c, i) => <li>{i < all.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
  </ol></nav>
)}
<slot />
<section class="band">
  <div class="wrap">
    <p class="eyebrow">{t.bandEyebrow}</p>
    <h2>{t.bandTitle}</h2>
    <p class="center">{t.bandText}</p>
    <div class="btns" style="justify-content:center">
      <a class="btn primary" href={site.reserveUrl!} rel="noopener">{t.reserve}</a>
      <a class="btn" href={'tel:' + site.phone}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIco}/></svg>{site.phoneDisplay}</a>
    </div>
  </div>
</section>
</main>
<footer><div class="wrap">
  <div class="fg">
    <div><a class="logo" href={pathFor(lang, 'home')}><b>Tele<i>pizza</i></b><small>{t.since}</small></a>
      <p style="margin-top:16px">{t.footerAbout}</p></div>
    <div><h2>{t.addressContact}</h2><p>{fullAddress}<br />
      <a href={'tel:' + site.phone}>{site.phoneDisplay}</a><br />
      <a href={'mailto:' + site.email}>{site.email}</a><br />
      <a href={site.mapsUrl}>{t.route}</a></p></div>
    <div><h2>{t.hours}</h2><p>{t.closedMon}<br />{site.hours.map(h => <span>{t.days[h.day as keyof typeof t.days]}: {h.open}–{h.close}<br /></span>)}</p></div>
    <div><h2>{t.discover}</h2>{lang !== 'nl' ? <ul>{(['home', 'menu', 'catering', 'about', 'contact'] as PageKey[]).map(k => <li><a href={pathFor(lang, k)}>{t.nav[k]}</a></li>)}</ul> : <ul>
      <li><a href="/menu-italiaans-restaurant-amstelveen/">Menu</a></li>
      <li><a href="/pizza-amstelveen/">Pizza</a></li>
      <li><a href="/pizza-soorten/">Pizzasoorten</a></li>
      <li><a href="/pasta-amstelveen/">Pasta</a></li>
      <li><a href="/kapsalon-amstelveen/">Kapsalon</a></li>
      <li><a href="/steak-grill-amstelveen/">Steaks & grill</a></li>
      <li><a href="/halal-restaurant-amstelveen/">Halal</a></li>
      <li><a href="/laat-open-amstelveen/">Laat open</a></li>
      <li><a href="/restaurant-amstelveen/">Restaurant</a></li>
      <li><a href="/bezorgen-amstelveen/">Bezorgen</a></li>
      <li><a href="/catering-bedrijven-amstelveen/">Catering</a></li>
      <li><a href="/reviews/">Reviews</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/veelgestelde-vragen/">FAQ</a></li>
    </ul>}</div>
  </div>
  <p class="legal">© {new Date().getFullYear()} {site.name} · <a href="https://www.instagram.com/telepizza_nl/" rel="noopener">Instagram</a> · <a href="https://www.tiktok.com/@telepizza_nl" rel="noopener">TikTok</a></p>
</div></footer>
<nav class="mbar" aria-label="Snelle acties">
  <a href={'tel:' + site.phone}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIco}/></svg>{t.call}</a>
  <a href={site.orderUrl!} rel="noopener">{t.orderShort}</a>
  <a class="o" href={site.reserveUrl!} rel="noopener">{t.reserve}</a>
</nav>
{overlay && <script is:inline>(function(){var h=document.getElementById('top');function f(){h.classList.toggle('solid',scrollY>40)}addEventListener('scroll',f,{passive:true});f();})();</script>}
</body>
</html>
