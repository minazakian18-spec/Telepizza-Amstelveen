---
import { site, fullAddress } from '../data/site';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import f1 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import f2 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import f3 from '@fontsource/montserrat/files/montserrat-latin-500-normal.woff2?url';
import f4 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-600-normal.woff2?url';
const fonts = [f1, f2, f3, f4];
interface Crumb { name: string; path: string }
interface Props { title: string; description: string; crumbs?: Crumb[]; schema?: object[]; overlay?: boolean }
const { title, description, crumbs = [], schema = [], overlay = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const restaurant: any = {
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'LocalBusiness'],
  '@id': site.url + '/#restaurant',
  name: site.name,
  url: site.url + '/',
  servesCuisine: ['Pizza', 'Italiaans', 'Pasta', 'Shoarma'],
  hasMenu: site.url + '/menu-italiaans-restaurant-amstelveen/',
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.postalCode, addressLocality: site.city, addressCountry: site.country },
  areaServed: 'Amstelveen',
};
if (site.phone) restaurant.telephone = site.phone;
if (site.email) restaurant.email = site.email;
if (site.geo) restaurant.geo = { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng };
if (site.foundingYear) restaurant.foundingDate = String(site.foundingYear);
if (site.reserveUrl) restaurant.acceptsReservations = site.reserveUrl;
if (site.sameAs.length) restaurant.sameAs = site.sameAs;
if (site.hours.length) restaurant.openingHoursSpecification = site.hours.map(h => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.schema, opens: h.open, closes: h.close }));

const all = [{ name: 'Home', path: '/' }, ...crumbs];
const breadcrumb = crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, site.url).href })),
} : null;
const ld = [restaurant, breadcrumb, ...schema].filter(Boolean);

const nav = [
  ['/', 'Home'],
  ['/menu-italiaans-restaurant-amstelveen/', 'Menu'],
  ['/catering-italiaans-restaurant-amstelveen/', 'Catering'],
  ['/over-ons-italiaans-restaurant-amstelveen/', 'About Us'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#1c1c1c" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{fonts.map(f => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
<meta property="og:type" content="website" />
<meta property="og:locale" content="nl_NL" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={site.url + '/og.png'} />
<meta name="twitter:card" content="summary_large_image" />
{ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
<slot name="head" />
<style is:global>
:root{--bg:#1c1c1c;--bg2:#262626;--ink:#fff;--muted:#d4d4d4;--line:#3a3a3a;--green:#009246;--red:#ce2b37;--gold:#f5b301}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font:400 17px/1.7 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--bg)}
@media(min-width:900px){body{font-size:18px}}
a{color:#fff}
img,video{max-width:100%;display:block}
h1,h2,h3{font-family:"Plus Jakarta Sans",system-ui,sans-serif;font-weight:600;line-height:1.1;letter-spacing:-.01em}
h1{font-size:clamp(2.6rem,7vw,4.7rem);margin:24px 0 16px}
h2{font-size:clamp(2.1rem,5.5vw,4rem);margin:0 0 20px}
h3{font-size:1.5rem;margin:0 0 8px}
.wrap{max-width:1200px;margin:0 auto;padding:0 16px}
.sec{padding:72px 0}
.sec.alt{background:var(--bg2)}
.center{text-align:center}
.center p{margin-left:auto;margin-right:auto}
p{max-width:68ch;color:var(--muted)}
/* header */
.top{position:relative;z-index:10;background:var(--bg)}
.top.overlay{position:absolute;left:0;right:0;top:0;background:transparent}
.top .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;padding-top:14px;padding-bottom:14px}
.logo{font-family:"Plus Jakarta Sans",sans-serif;font-weight:600;font-size:1.6rem;text-decoration:none;color:#fff}
.top ul{display:flex;flex-wrap:wrap;align-items:center;gap:4px 22px;list-style:none;margin:0;padding:0}
.top nav a{font-family:Montserrat,sans-serif;font-weight:500;text-decoration:none;display:inline-flex;align-items:center;min-height:44px}
.top nav a:hover,.top nav a[aria-current]{text-decoration:underline;text-underline-offset:6px}
.ico{width:22px;height:22px;fill:#fff}
/* buttons */
.btns{display:flex;flex-wrap:wrap;gap:14px;margin-top:24px}
.center .btns{justify-content:center}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:12px 30px;border:2px solid #fff;background:rgba(0,0,0,.35);color:#fff;font-family:Montserrat,sans-serif;font-weight:500;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;font-size:.95rem}
.btn:hover,.btn:focus-visible{background:#fff;color:#1c1c1c}
.flag{display:flex;width:150px;height:6px;margin:0 auto}
.flag i{flex:1}.flag i:nth-child(1){background:var(--green)}.flag i:nth-child(2){background:#fff}.flag i:nth-child(3){background:var(--red)}
/* page hero for subpages */
.phero{padding:40px 0 48px;border-bottom:1px solid var(--line)}
.lead{font-size:1.15rem;color:#e8e8e8}
.crumbs{font-size:.9rem;color:var(--muted);padding-top:8px}
.crumbs ol{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0}
.crumbs li+li::before{content:"›";margin-right:6px}
main .wrap>h2,main section h2{margin-top:48px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-top:20px}
.card{background:var(--bg2);border:1px solid var(--line);padding:22px}
.card h2,.card h3{margin-top:0}
table{border-collapse:collapse;width:100%}
td,th{text-align:left;padding:12px 8px;border-bottom:1px solid var(--line);vertical-align:top}
td span{color:var(--muted)}
details{background:var(--bg2);border:1px solid var(--line);padding:14px 18px;margin:12px 0}
summary{font-weight:600;cursor:pointer}
main{padding-bottom:0}
main>.wrap{padding-bottom:64px}
/* CTA band + footer */
.band{text-align:center;padding:80px 0;background:#111}
.band h2{margin-bottom:8px}
.band .sub{font-family:"Plus Jakarta Sans",sans-serif;font-size:clamp(1.3rem,3vw,2rem);color:#fff;margin:0 auto}
footer{background:#111;border-top:1px solid var(--line);padding:48px 0;font-size:.95rem}
footer .grid{margin-top:0}
footer h2{font-size:1.2rem;margin:0 0 10px}
footer p{margin:0}
footer .links a{margin-right:10px}
</style>
</head>
<body>
<header class:list={['top', { overlay }]}><div class="wrap">
  <a class="logo" href="/">Telepizza</a>
  <nav aria-label="Hoofdmenu"><ul>
    {nav.map(([h, t]) => <li><a href={h} aria-current={path === h ? 'page' : undefined}>{t}</a></li>)}
    <li><a href="https://www.tiktok.com/@telepizza_nl" rel="noopener" aria-label="TikTok"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.7 5.7 0 1 0 4.9 5.7V9a7.4 7.4 0 0 0 4.3 1.4V7.3a4.3 4.3 0 0 1-3.2-1.5z"/></svg></a></li>
    <li><a href="https://www.instagram.com/telepizza_nl/" rel="noopener" aria-label="Instagram"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM12 2c-2.7 0-3 0-4.1.1C4.3 2.2 2.2 4.3 2.1 7.9 2 9 2 9.3 2 12s0 3 .1 4.1c.1 3.6 2.2 5.7 5.8 5.8 1.1.1 1.4.1 4.1.1s3 0 4.1-.1c3.6-.1 5.7-2.2 5.8-5.8.1-1.1.1-1.4.1-4.1s0-3-.1-4.1c-.1-3.6-2.2-5.7-5.8-5.8C15 2 14.7 2 12 2zm0 1.8c2.7 0 3 0 4 .1 2.6.1 3.9 1.4 4 4 .1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.6-1.4 3.9-4 4-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.6-.1-3.9-1.4-4-4-.1-1-.1-1.3-.1-4s0-3 .1-4c.1-2.6 1.4-3.9 4-4 1-.1 1.3-.1 4-.1z"/></svg></a></li>
  </ul></nav>
</div></header>
<main id="inhoud">
{crumbs.length > 0 && (
  <nav class="crumbs wrap" aria-label="Kruimelpad"><ol>
    {all.map((c, i) => <li>{i < all.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
  </ol></nav>
)}
<slot />
<section class="band">
  <div class="wrap">
    <h2>Reserveren bij de beste</h2>
    <p class="sub">Italiaans restaurant in Amstelveen</p>
    <div class="btns" style="justify-content:center"><a class="btn" href={site.reserveUrl!} rel="noopener">Reserveren</a></div>
  </div>
</section>
</main>
<footer><div class="wrap grid">
  <div><h2>Adres</h2><p>{site.name}<br />{fullAddress}</p><p style="margin-top:8px"><a href="/contact-route/">Route plannen</a></p></div>
  <div><h2>Contact</h2><p>
    <a href={'tel:' + site.phone}>{site.phoneDisplay}</a><br />
    <a href={'mailto:' + site.email}>{site.email}</a><br />
    <a href="https://www.instagram.com/telepizza_nl/" rel="noopener">Instagram</a> · <a href="https://www.tiktok.com/@telepizza_nl" rel="noopener">TikTok</a></p></div>
  <div><h2>Openingstijden</h2><p>Maandag: gesloten<br />{site.hours.map(h => <span>{h.day}: {h.open}–{h.close}<br /></span>)}</p></div>
  <div class="links"><h2>Meer</h2><p>
    <a href="/pizza-amstelveen/">Pizza</a> <a href="/pasta-amstelveen/">Pasta</a> <a href="/pizza-soorten/">Pizzasoorten</a> <a href="/restaurant-amstelveen/">Restaurant</a> <a href="/bezorgen-amstelveen/">Bezorgen</a> <a href="/catering-bedrijven-amstelveen/">Catering bedrijven</a> <a href="/veelgestelde-vragen/">FAQ</a> <a href="/contact-route/">Contact</a></p></div>
</div></footer>
</body>
</html>
