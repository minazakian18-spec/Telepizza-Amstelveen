---
import Base from '../layouts/Base.astro';
import { site, fullAddress } from '../data/site';
import { media } from '../lib/media';
const video = media('hero-video.mp4');
const poster = media('restaurant-binnen.webp');
const pepperoni = media('pepperoni-pizza.webp');
const carbonara = media('pasta-carbonara.webp');
const krant = media('krantenartikel.png');
const stars = '★★★★★';
---
<Base overlay title="Telepizza Amstelveen | Italiaans restaurant, pizza bezorgen & afhalen" description={`Telepizza: Italiaans restaurant in Amstelveen sinds 1984. Pizza, pasta, grill en meer. Reserveer, bestel online of laat bezorgen. ${fullAddress}.`}>
  {poster && <link slot="head" rel="preload" as="image" href={poster} fetchpriority="high" />}
  <style>
    .hero{position:relative;min-height:100svh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;background:#111 center/cover no-repeat}
    .hero video,.hero .poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .hero::after{content:"";position:absolute;inset:0;background:rgba(0,0,0,.6)}
    .hero .in{position:relative;z-index:1;padding:110px 16px 60px}
    .hero h1{font-size:clamp(3.4rem,13vw,8rem);margin:0 0 14px}
    .est{font-family:Montserrat,sans-serif;letter-spacing:.35em;margin:16px 0 4px;color:#fff}
    .tag{font-family:"Plus Jakarta Sans",sans-serif;font-size:clamp(1.2rem,3vw,1.8rem);color:#fff;margin:0 auto}
    .call{display:inline-flex;align-items:center;gap:10px;margin-top:28px;font-family:Montserrat,sans-serif;text-decoration:none;letter-spacing:.08em}
    .call small{display:block;font-size:.8rem;opacity:.85}
    .badge{display:flex;justify-content:center;margin-top:-34px;position:relative;z-index:2}
    .badge div{display:flex;align-items:center;gap:14px;background:#fff;color:#1c1c1c;padding:12px 24px;border-radius:999px;box-shadow:0 10px 30px rgba(0,0,0,.4);font-family:Montserrat,sans-serif;font-weight:500}
    .badge b{font-size:1.4rem}
    .stars{color:#b37b00;letter-spacing:2px}
    .split{display:grid;gap:40px;align-items:center}
    @media(min-width:900px){.split{grid-template-columns:1fr 1fr}.split.spec{grid-template-columns:1fr 2fr}}
    .ph{background:linear-gradient(135deg,#2c2c2c,#3a3a3a);aspect-ratio:4/3;width:100%;object-fit:cover}
    .dish{background:var(--bg2);border:1px solid var(--line)}
    .dish .ph{aspect-ratio:4/3}
    .dish div{padding:20px}
    .price{font-family:"Plus Jakarta Sans",sans-serif;font-size:1.4rem;color:#fff;margin:6px 0 0}
    .reviews{background:#fff;color:#1c1c1c}
    .reviews p{color:#333}
    .reviews h2{color:#1c1c1c}
    .sum{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px 18px;margin-bottom:28px}
    .sum strong{font-family:"Plus Jakarta Sans",sans-serif;font-size:1.6rem;letter-spacing:.05em}
    .sum .stars{font-size:1.4rem}
    .rv{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
    .rv figure{margin:0;background:#f5f5f5;padding:22px;border-radius:10px}
    .rv blockquote{margin:8px 0 12px;color:#222}
    .rv figcaption{font-weight:600}
  </style>
  <section class="hero">
    {poster && <img class="poster" src={poster} alt="" width="1920" height="1080" fetchpriority="high" />}
    {video && <video id="hv" muted loop playsinline preload="none" poster={poster ?? undefined} aria-hidden="true" data-src={video}></video>}
    <div class="in">
      <h1>Telepizza</h1>
      <div class="flag" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="est">EST. 1984</p>
      <p class="tag">Italiaans restaurant in Amstelveen</p>
      <div class="btns" style="justify-content:center">
        <a class="btn" href={site.reserveUrl!} rel="noopener">Reserveren</a>
        <a class="btn" href={site.orderUrl!} rel="noopener">Bestel Online</a>
      </div>
      <div><a class="call" href={'tel:' + site.phone}><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg><span><small>CALL US</small>{site.phoneDisplay}</span></a></div>
    </div>
  </section>
  <div class="badge"><div><span>Google</span><b>4.7</b><span class="stars" aria-hidden="true">{stars}</span><span>Top Rated Restaurant 2026</span></div></div>

  <section class="sec center"><div class="wrap">
    <h2>Welkom bij Telepizza</h2>
    <p>Al sinds 1984 de plek in Amstelveen voor pizza, pasta en gezelligheid. Wat begon als afhaalzaak is uitgegroeid tot een volwaardig Italiaans restaurant aan de Amsterdamseweg. Kom bij ons eten, haal af of laat bezorgen.</p>
    <div class="btns"><a class="btn" href={site.reserveUrl!} rel="noopener">Reserveren</a></div>
  </div></section>

  <section class="sec alt"><div class="wrap split">
    <div>
      <h2>Telepizza, Not Your Average Restaurant</h2>
      <p>Al onze gerechten worden met verse producten en veel zorg voor je bereid. Van een klassieke margherita tot truffelpasta, biefstuk en verse shoarma van de spies: er is voor ieder wat wils.</p>
      <p>Snelle, vriendelijke service en betaalbare prijzen, dat is waar onze gasten ons voor terugkomen.</p>
      <div class="btns"><a class="btn" href="/over-ons-italiaans-restaurant-amstelveen/">Over ons</a></div>
    </div>
    {pepperoni ? <img class="ph" src={pepperoni} alt="Pepperoni pizza van Telepizza Amstelveen" width="800" height="600" loading="lazy" decoding="async" /> : <div class="ph" role="presentation"></div>}
  </div></section>

  <section class="sec"><div class="wrap split spec">
    <div>
      <h2>Onze Specialiteiten</h2>
      <div class="btns"><a class="btn" href="/menu-italiaans-restaurant-amstelveen/">Bekijk het volledige menu</a></div>
    </div>
    <div class="grid" style="margin-top:0">
      <article class="dish">
        {pepperoni ? <img class="ph" src={pepperoni} alt="Klassieke Pepperoni Pizza" width="600" height="450" loading="lazy" decoding="async" /> : <div class="ph" role="presentation"></div>}
        <div><h3>Klassieke Pepperoni Pizza</h3><p>Tomatensaus, kaas en pepperoni.</p><p class="price">€ 12,95</p></div>
      </article>
      <article class="dish">
        {carbonara ? <img class="ph" src={carbonara} alt="Romige Pasta Carbonara" width="600" height="450" loading="lazy" decoding="async" /> : <div class="ph" role="presentation"></div>}
        <div><h3>Romige Pasta Carbonara</h3><p>Met spek, ei, roomsaus en Parmezaanse kaas.</p><p class="price">€ 12,95</p></div>
      </article>
    </div>
  </div></section>

  <section class="sec reviews center"><div class="wrap">
    <h2>Wat onze gasten zeggen</h2>
    <div class="sum"><strong>EXCELLENT</strong><span class="stars" aria-label="5 sterren">{stars}</span><span>Based on <b>{site.rating.count} reviews</b></span><span style="font-weight:600"><span style="color:#4285F4">G</span><span style="color:#EA4335">o</span><span style="color:#FBBC05">o</span><span style="color:#4285F4">g</span><span style="color:#34A853">l</span><span style="color:#EA4335">e</span></span></div>
    <div class="rv" style="text-align:left">{site.reviews.map(r => <figure><span class="stars" aria-hidden="true">{stars}</span><blockquote lang="en">{r.text}</blockquote><figcaption>{r.author}</figcaption></figure>)}</div>
  </div></section>

  <section class="sec"><div class="wrap split">
    {krant ? <img src={krant} alt="Krantenartikel over de vernieuwde Telepizza in Amstelveen" width="800" height="1000" loading="lazy" decoding="async" style="width:100%;height:auto" /> : <div class="ph" role="presentation"></div>}
    <div>
      <h2>Bekend van social media en de krant</h2>
      <p>Onze video’s op <a href="https://www.instagram.com/telepizza_nl/" rel="noopener">Instagram</a> en <a href="https://www.tiktok.com/@telepizza_nl" rel="noopener">TikTok</a> zijn samen meer dan 300.000 keer bekeken. De lokale krant schreef over onze vernieuwde zaak: van afhaalzaak naar restaurant.</p>
      <p>Benieuwd? Bekijk ons <a href="/menu-italiaans-restaurant-amstelveen/">menu</a>, lees over <a href="/bezorgen-amstelveen/">bezorgen in jouw wijk</a> of onze <a href="/catering-italiaans-restaurant-amstelveen/">catering</a>.</p>
    </div>
  </div></section>

  <script is:inline>
    // Video alleen laden op grotere schermen zonder databesparing; mobiel toont de foto.
    (function(){var v=document.getElementById('hv');if(!v)return;var c=navigator.connection;
      if(!matchMedia('(min-width:768px)').matches||matchMedia('(prefers-reduced-motion: reduce)').matches||(c&&c.saveData))return;
      addEventListener('load',function(){v.src=v.dataset.src;v.play().catch(function(){});});})();
  </script>
</Base>
