---
import HomeView from '../components/HomeView.astro';
import { site, fullAddress } from '../data/site';
import type { HomeCopy } from '../i18n/pages';

const c: HomeCopy = {
  title: 'Telepizza Amstelveen | Italiaans restaurant & pizzeria sinds 1984',
  desc: `Italiaans restaurant in Amstelveen sinds 1984. Pizza uit de oven, verse pasta en steaks van de grill in een sfeervolle zaal. Halal vlees, open tot 03:00. ★ ${site.rating.value} uit ${site.rating.count} Google-reviews. Reserveer een tafel.`,
  h1: 'Italiaans restaurant <i>in Amstelveen</i>',
  lead: 'Al sinds 1984 aan de Amsterdamseweg. Schuif aan voor pizza uit de oven, verse pasta, steaks van de grill en een goed glas wijn.',
  storyTitle: 'Een Italiaanse avond, <i>al ruim veertig jaar</i>',
  story: [
    'Telepizza is in 1984 begonnen aan de Amsterdamseweg en is uitgegroeid tot een sfeervol Italiaans restaurant. Hier eet je met familie, vrienden of collega’s aan gedekte tafels, met gerechten die we elke dag vers bereiden: van handgerekt pizzadeeg en huisgemaakte sauzen tot sappige steaks van de grill.',
    'Een groene wand, warm licht, neon aan de muur en een bediening die je bij naam onthoudt. Onze gasten noemen vooral de gastvrijheid, de smaak en de eerlijke prijzen. Kom voor een etentje met twee, een verjaardag met de hele familie of een late avond met vrienden: de keuken is open tot 01:45, in het weekend tot 03:00.',
  ],
  salaTitle: 'Gedekte tafels, warm licht en echte gastvrijheid',
  menuEyebrow: '', menuTitle: '',
  facts: [['Sinds 1984', 'ruim veertig jaar in Amstelveen'], ['Halal', 'al ons vlees'], ['Tot 03:00', 'op vrijdag en zaterdag'], [`★ ${site.rating.value}`, `${site.rating.count} Google-reviews`]],
  cats: [['Pizza uit de oven', 'Handgerekt deeg, huisgemaakte tomatensaus'], ['Verse pasta', 'Carbonara, tartufo, frutti di mare'], ['', ''], ['Specialità della casa', 'Onze speciale pizza’s met geitenkaas, truffel en Parmaham']],
  favEyebrow: 'La nostra carta', favTitle: 'Specialiteiten van het huis',
  waysTitle: 'Voor elke gelegenheid',
  ways: [
    ['Diner voor twee', 'Een romige pasta, een pizza om te delen en een fles wijn. Reserveer je tafel online via TheFork.'],
    ['Familie & verjaardagen', 'Grote tafels, iets voor ieder wat wils en kinderen zijn welkom. Bel ons voor groepen.'],
    ['Avond met vrienden', 'Cocktails, pizza en een keuken die open is tot 03:00 in het weekend.'],
    ['Catering & bedrijven', 'Italiaanse catering voor feesten, kantoor en borrels in Amstelveen. <a href="/catering-italiaans-restaurant-amstelveen/">Meer over catering</a>.'],
  ],
  pressTitle: 'Bekend van de krant en social media',
  press: 'De lokale krant schreef over onze vernieuwde zaak en hoe Telepizza uitgroeide tot een volwaardig restaurant. Video’s van onze gerechten en sfeer zijn op Instagram en TikTok samen al meer dan 300.000 keer bekeken.',
  seoTitle: 'Uit eten in Amstelveen: pizza, pasta en grill',
  seo: [
    ['Pizza in Amstelveen', 'Onze <a href="/pizza-amstelveen/">pizza’s</a> maken we met handgerekt deeg, huisgemaakte tomatensaus en verse ingrediënten. Kies een klassieke margherita, de populaire Tele Pizza of een pizza met truffel en Parmaham. Ruim 35 soorten, ook <a href="/pizza-soorten/">vegetarisch en met vis</a>.'],
    ['Pasta en steaks van de grill', 'Van carbonara en bolognese tot tartufo zucchine en frutti di mare: onze <a href="/pasta-amstelveen/">pasta’s</a> worden vers bereid. Liever vlees? Bestel <a href="/steak-grill-amstelveen/">biefstuk, ribeye, ossenhaas of spare ribs</a>, met salade en frites.'],
    ['Halal en tot laat open', 'Al ons vlees is <a href="/halal-restaurant-amstelveen/">halal</a>. Naast Italiaanse gerechten staan ook burgers, shoarma en <a href="/kapsalon-amstelveen/">kapsalon</a> op de kaart. En wie laat trek heeft: we zijn <a href="/laat-open-amstelveen/">open tot 01:45</a>, in het weekend tot 03:00.'],
    ['Thuis genieten', 'Kun je niet komen? Je kunt ook <a href="/bezorgen-amstelveen/">afhalen of laten bezorgen in Amstelveen</a>, of <a href="/catering-bedrijven-amstelveen/">catering voor je bedrijf</a> bestellen.'],
  ],
  faq: [
    ['Kan ik bij Telepizza reserveren?', `Ja, reserveer online via TheFork of bel ${site.phoneDisplay}. Voor groepen en verjaardagen denken we graag mee.`],
    ['Waar zit Telepizza Amstelveen?', `Aan de ${fullAddress}, in het noorden van Amstelveen, vlak bij Randwijck en de grens met Amsterdam.`],
    ['Tot hoe laat is de keuken open?', 'Dinsdag tot en met donderdag en op zondag van 15:00 tot 01:45. Vrijdag en zaterdag tot 03:00. Op maandag zijn we gesloten.'],
    ['Is het vlees halal?', 'Ja, al ons vlees is halal.'],
    ['Kan ik ook afhalen of laten bezorgen?', 'Ja, via onze online bestelwinkel kun je afhalen of laten bezorgen in Amstelveen.'],
  ],
};
---
<HomeView lang="nl" c={c}>
  <p slot="faqmore" class="center" style="margin-top:24px"><a href="/veelgestelde-vragen/">Meer vragen en antwoorden</a></p>
</HomeView>
