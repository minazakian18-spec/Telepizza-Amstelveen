---
import HomeView from '../components/HomeView.astro';
import { site, fullAddress } from '../data/site';
import type { HomeCopy } from '../i18n/pages';

const c: HomeCopy = {
  title: 'Italiaans restaurant Amstelveen ★ 4,7 | Telepizza',
  desc: `De italiaan van Amstelveen sinds 1984: pizza, pasta en grill, halal vlees, open tot 03:00 in het weekend. ★ 4,7 op Google. Reserveer of bestel direct.`,
  h1: 'Italiaans restaurant <i>in Amstelveen</i>',
  lead: 'Sinds 1984 dé italiaan in Amstelveen, aan de Amsterdamseweg 452. Handgerekt pizzadeeg, verse pasta en steaks van de grill: eet bij ons, haal af of laat bezorgen in Amstelveen en Buitenveldert.',
  storyTitle: 'Een Italiaanse avond, <i>al ruim veertig jaar</i>',
  story: [
    'Telepizza is in 1984 begonnen aan de Amsterdamseweg en is uitgegroeid tot een sfeervol Italiaans restaurant. Hier eet je met familie, vrienden of collega’s aan gedekte tafels, met gerechten die we elke dag vers bereiden: van handgerekt pizzadeeg en huisgemaakte sauzen tot sappige steaks van de grill.',
    'Een groene wand, warm licht, neon aan de muur en een bediening die je bij naam onthoudt. Onze gasten noemen vooral de gastvrijheid, de smaak en de eerlijke prijzen. Kom voor een etentje met twee, een verjaardag met de hele familie of een late avond met vrienden: we zijn open tot 01:45, op vrijdag en zaterdag tot 03:00.',
  ],
  salaTitle: 'Gedekte tafels, warm licht en echte gastvrijheid',
  menuEyebrow: '', menuTitle: '',
  facts: [['Sinds 1984', 'familiebedrijf'], [`★ ${site.rating.value}`.replace('.', ','), `${site.rating.count.toLocaleString('nl-NL')} Google-reviews`], ['Halal', 'al ons vlees'], ['Bezorgen', '& afhalen']], // TODO-CONTROLEREN: halal
  cats: [['Pizza uit de oven', 'Handgerekt deeg, huisgemaakte tomatensaus'], ['Verse pasta', 'Carbonara, tartufo, frutti di mare'], ['', ''], ['Specialità della casa', 'Onze speciale pizza’s met geitenkaas, truffel en Parmaham']],
  favEyebrow: 'Onze kaart', favTitle: 'Specialiteiten van het huis',
  waysTitle: 'Voor elke gelegenheid',
  ways: [
    ['Diner voor twee', 'Een romige pasta, een pizza om te delen en een fles wijn. Reserveer je tafel online via TheFork.'],
    ['Familie & verjaardagen', 'Grote tafels, iets voor ieder wat wils en kinderen zijn welkom. Bel ons voor groepen.'],
    ['Avond met vrienden', 'Cocktails en pizza tot laat: op vrijdag en zaterdag zijn we open tot 03:00.'],
    ['Catering & bedrijven', 'Italiaanse catering voor feesten, kantoor en borrels in Amstelveen. <a href="/catering-italiaans-restaurant-amstelveen/">Meer over catering</a>.'],
  ],
  pressTitle: 'Bekend van de krant en social media',
  press: 'De lokale krant schreef over onze vernieuwde zaak en hoe Telepizza uitgroeide tot een volwaardig restaurant. Video’s van onze gerechten en sfeer zijn op Instagram en TikTok samen al meer dan 300.000 keer bekeken.',
  seoTitle: 'Waarom wij de italiaan van Amstelveen zijn',
  seo: [
    ['Sinds 1984 een familiebedrijf', `Al ruim veertig jaar staan we aan de Amsterdamseweg. Telepizza is een familiebedrijf, en veel gasten komen hier al sinds hun jeugd. Op Google geven gasten ons een ${String(site.rating.value).replace('.', ',')} uit ${site.rating.count.toLocaleString('nl-NL')} reviews. Wil je uit eten? Lees meer over ons <a href="/restaurant-amstelveen/">restaurant in Amstelveen</a>.`],
    ['Handgerekt deeg en open tot 03:00', 'Elke pizzabodem rekken we met de hand uit, de tomatensaus maken we zelf. En je hoeft niet vroeg te komen: we zijn open tot 01:45, op vrijdag en zaterdag tot 03:00.'],
    ['Pizza in Amstelveen', 'Als pizzeria maken we <a href="/pizza-amstelveen/">pizza in Amstelveen</a> met handgerekt deeg, huisgemaakte tomatensaus en verse ingrediënten. Kies een klassieke margherita, de populaire Telepizza of een pizza met truffel en Parmaham. Ruim 30 soorten, ook <a href="/menu-italiaans-restaurant-amstelveen/#pizza">vegetarisch en met vis</a>.'],
    ['Pasta en steaks van de grill', 'Van carbonara en bolognese tot tartufo zucchine en frutti di mare: onze <a href="/pasta-amstelveen/">pasta in Amstelveen</a> wordt vers bereid. Liever vlees? Bestel <a href="/steak-grill-amstelveen/">biefstuk, ribeye, ossenhaas of spare ribs</a>, met salade en frites.'],
    ['Halal en tot laat open', 'Al ons vlees is <a href="/halal-restaurant-amstelveen/">halal</a>. Naast Italiaanse gerechten staan ook burgers, <a href="/shoarma-amstelveen/">shoarma</a> en <a href="/kapsalon-amstelveen/">kapsalon</a> op de kaart. En wie laat trek heeft: we zijn <a href="/laat-open-amstelveen/">open tot 01:45</a>, op vrijdag en zaterdag tot 03:00.'],
    ['Thuis genieten', 'Kun je niet komen? Via <a href="/bezorgen-amstelveen/">eten bestellen in Amstelveen</a> kun je afhalen of laten bezorgen in Amstelveen, Buitenveldert en de Zuidas. Voor feesten en bedrijven is er <a href="/catering-italiaans-restaurant-amstelveen/">catering in Amstelveen</a>.'],
    ['Spreek je liever Engels?', 'Onze menukaart is ook in het Engels beschikbaar en ons team spreekt Engels. Handig voor internationale gasten in Amstelveen. <a href="/en/">Bekijk onze Engelse website</a>.'],
  ],
  faq: [
    ['Kan ik bij Telepizza reserveren?', `Ja, reserveer online via TheFork of bel ${site.phoneDisplay}. Voor groepen en verjaardagen denken we graag mee.`],
    ['Waar zit Telepizza Amstelveen?', `Aan de ${fullAddress}, in het noorden van Amstelveen, vlak bij Randwijck en de grens met Amsterdam.`],
    ['Tot hoe laat zijn jullie open?', 'Dinsdag tot en met donderdag en op zondag van 15:00 tot 01:45. Vrijdag en zaterdag tot 03:00. Op maandag zijn we gesloten.'],
    ['Is het vlees halal?', 'Ja, al ons vlees is halal, behalve gerechten met het label ‘Niet halal’ (met varkensvlees).'],
    ['Kan ik ook afhalen of laten bezorgen?', 'Ja. Afhalen kan tijdens de openingstijden aan de Amsterdamseweg 452. We bezorgen in Amstelveen, Buitenveldert en op de Zuidas: dinsdag t/m donderdag tot 21:00, vrijdag en zaterdag tot 21:30 en zondag tot 20:30. Alles over bezorgkosten en postcodes lees je op <a href="/bezorgen-amstelveen/">bezorgen in Amstelveen</a>.'],
  ],
};
---
<HomeView lang="nl" c={c}>
  <p slot="faqmore" class="center" style="margin-top:24px"><a href="/veelgestelde-vragen/">Meer vragen en antwoorden</a></p>
</HomeView>
