---
import { existsSync } from 'node:fs';
import HalalInfo from '../components/HalalInfo.astro';
import Base from '../layouts/Base.astro';
import { menu } from '../data/menu';
import { site } from '../data/site';
import { dishes, notHalalLabel } from '../data/dishes';
import { sitedishPhoto } from '../data/sitedish-photos';
const menuLd = {
  '@context': 'https://schema.org', '@type': 'Menu', name: 'Menu Telepizza Amstelveen', url: site.url + '/menu-italiaans-restaurant-amstelveen/', inLanguage: 'nl',
  hasMenuSection: menu.map(s => ({ '@type': 'MenuSection', name: s.name,
    hasMenuItem: s.items.map(i => ({ '@type': 'MenuItem', name: i.name, ...(i.description && { description: i.description }), ...(i.price != null && { offers: { '@type': 'Offer', price: i.price.toFixed(2), priceCurrency: 'EUR' } }) })) })),
};
const slug = (n: string) => n.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const eur = (p: number) => '€ ' + p.toFixed(2).replace('.', ',');
// Foto alleen bij een exacte naam, zodat een pizza nooit de foto van de pasta met dezelfde naam krijgt (en andersom).
const norm = (n: string) => n.toLowerCase().replace(/[^a-z]/g, '');
// Foto bij een gerecht als we die hebben (zelfde naam, met of zonder "Pizza"/"Pasta").
const photos = new Map(Object.values(dishes).map(d => [norm(d.name), d.img]));
// Eigen foto via de upload-workflow (npm run photos): public/images/menu/<slug>.webp gaat voor op de vaste koppeling.
const local = (n: string) => existsSync(`public/images/menu/${slug(n)}.webp`) ? slug(n) : photos.get(norm(n));
// Volgorde: eigen bestand / vaste koppeling, anders de foto uit de Sitedish-bestelwinkel.
const photoOf = (n: string) => { const l = local(n); return l ? '/images/menu/' + l + '.webp' : sitedishPhoto(slug(n)); };
---
<Base page="menu" title="Menukaart & prijzen | Telepizza Amstelveen" description="Bekijk de volledige menukaart met prijzen: 30+ pizza's, verse pasta, steaks, shoarma, burgers en desserts. Bestel online of reserveer een tafel." crumbs={[{ name: 'Menu', path: '/menu-italiaans-restaurant-amstelveen/' }]} schema={[menuLd]}>
  <style>
    .mh{padding-top:20px;padding-bottom:24px}
    .mh .lead{margin-bottom:10px}
    .chips{position:sticky;top:78px;z-index:20;background:var(--bg);border-bottom:1px solid rgba(0,0,0,.12);box-shadow:0 6px 12px -10px rgba(0,0,0,.35)}
    .chips .wrap{display:flex;gap:12px;align-items:center;padding-block:10px}
    .chips input{flex:none;width:170px;min-height:40px;padding:0 14px;border:2px solid var(--ink);border-radius:999px;font:600 16px var(--sans,inherit);background:#fff}
    .chips ul{display:flex;gap:8px;overflow-x:auto;list-style:none;margin:0;padding:2px 0;scrollbar-width:none;-webkit-mask-image:linear-gradient(90deg,#000 92%,transparent)}
    .chips ul::-webkit-scrollbar{display:none}
    .chips a{display:inline-flex;align-items:center;min-height:40px;white-space:nowrap;padding:0 16px;border-radius:999px;background:#f1e8dc;text-decoration:none;color:var(--ink);font:800 .74rem/1 var(--head);letter-spacing:.06em;text-transform:uppercase;transition:background .15s,color .15s}
    .chips a:hover{background:#e6d6c2}
    .chips a.on{background:var(--red);color:#fff}
    @media(max-width:700px){.chips .wrap{flex-direction:column;align-items:stretch;gap:8px}.chips input{width:100%}}
    .msec{padding:40px 0 4px;scroll-margin-top:150px}
    .msec h2{margin:0 0 6px}
    .msec .note{margin:0 0 14px;color:var(--muted)}
    .items{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(min(100%,440px),1fr))}
    .it{display:flex;gap:14px;align-items:center;padding:12px;border-radius:14px;background:#fff;box-shadow:0 1px 0 rgba(0,0,0,.08),0 4px 14px -8px rgba(0,0,0,.25)}
    .it img{width:104px;height:104px;object-fit:cover;border-radius:10px;flex:none;background:#f4ede3}
    .it div{flex:1;min-width:0}
    .it h3{font-size:1.05rem;margin:0}
    .it .nh{display:inline-block;margin-inline-start:8px;padding:3px 8px;border-radius:999px;background:#141414;color:#fff;font:800 .62rem/1.2 var(--head);letter-spacing:.06em;text-transform:uppercase;vertical-align:middle}
    .it p{margin:3px 0 0;font-size:.86rem;line-height:1.4;color:var(--muted)}
    .it .price{align-self:flex-start;white-space:nowrap;font:900 1.05rem/1.3 var(--head);color:var(--red)}
    .none{display:none;padding:40px 0;text-align:center}
    [hidden]{display:none!important}
  </style>
  <div class="wrap mh">
    <h1>Menukaart Telepizza Amstelveen</h1>
    <p class="lead">Pizza, pasta, grill, shoarma en desserts, met prijzen.</p>
    <p class="menu-halal"><HalalInfo /> · gerechten met varkensvlees hebben het label ‘Niet halal’</p>
    <div class="btns"><a class="btn primary" href={site.orderUrl!} rel="noopener">Bezorgen / afhalen</a><a class="btn" href={site.reserveUrl!} rel="noopener">Reserveer een tafel</a></div>
  </div>
  <nav class="chips" aria-label="Menucategorieën"><div class="wrap">
    <input type="search" id="mzoek" placeholder="Zoek gerecht…" aria-label="Zoek in het menu" />
    <ul>{menu.map(s => <li><a href={'#' + slug(s.name)}>{s.name}</a></li>)}</ul>
  </div></nav>
  <div class="wrap">
    {menu.map(s => (
      <section class="msec" id={slug(s.name)}>
        {s.name === 'Vegetarische Pizza’s' && <span id="pizza"></span>}
        <h2>{s.name}</h2>{s.note && <p class="note">{s.note}</p>}
        <div class="items">
          {s.items.map(i => { const img = photoOf(i.name); return (
            <article class="it">
              {img && <img src={img} alt={i.name + ' bij Telepizza Amstelveen'} width="104" height="104" loading="lazy" decoding="async" />}
              <div><h3>{i.name}{i.notHalal && <><span class="sr-only"> – </span><span class="nh">{notHalalLabel['nl'] ?? notHalalLabel.en}</span></>}</h3>{i.description && <p>{i.description}</p>}</div>{" "}
              <span class="price">{i.priceText ?? (i.price != null ? eur(i.price) : '')}</span>
            </article>); })}
        </div>
      </section>
    ))}
    <p class="none" id="mgeen">Geen gerecht gevonden.</p>
    <p style="margin-top:48px">Liever thuis eten? <a href={site.orderUrl!}>Bestel online</a> of bel <a href={'tel:' + site.phone}>{site.phoneDisplay}</a>. Prijzen kunnen afwijken in de online bestelwinkel. Alles over onze <a href="/pizza-amstelveen/">pizza in Amstelveen</a>, van deeg tot bezorging, lees je op de pizzapagina.</p>
  </div>
  <script is:inline>(function(){
    var secs=[].slice.call(document.querySelectorAll('.msec')),links=[].slice.call(document.querySelectorAll('.chips a')),ul=document.querySelector('.chips ul');
    function on(id){links.forEach(function(a){var m=a.getAttribute('href')==='#'+id;a.classList.toggle('on',m);if(m)ul.scrollTo({left:a.offsetLeft-ul.offsetLeft-12,behavior:'smooth'})})}
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)on(e.target.id)})},{rootMargin:'-160px 0px -60% 0px'});
    secs.forEach(function(s){io.observe(s)});
    var q=document.getElementById('mzoek'),none=document.getElementById('mgeen');
    q.addEventListener('input',function(){var t=q.value.trim().toLowerCase(),any=false;
      secs.forEach(function(s){var n=0;s.querySelectorAll('.it').forEach(function(it){var m=!t||it.textContent.toLowerCase().indexOf(t)>-1;it.hidden=!m;if(m)n++});s.hidden=!n;if(n)any=true});
      none.style.display=any?'none':'block'});
  })();</script>
</Base>
