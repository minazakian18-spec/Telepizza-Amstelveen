---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { wijken, type Wijk } from '../../data/wijken';
export function getStaticPaths() { return wijken.map(w => ({ params: { wijk: w.slug }, props: { w } })); }
const { w } = Astro.props as { w: Wijk };
const loc = ({ stadshart: 'in het Stadshart', 'oude-dorp': 'in het Oude Dorp', zuidas: 'op de Zuidas' } as Record<string, string>)[w.slug] ?? `in ${w.name}`;
const others = wijken.filter(o => o.slug !== w.slug);
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: w.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base title={`Pizza bezorgen ${w.name} | Telepizza Amstelveen`} description={`Pizza bestellen in ${w.name}? Telepizza bezorgt vers bereide pizza, pasta en grill. Bestel online of haal af aan de Amsterdamseweg 452.`} crumbs={[{ name: 'Bezorgen', path: '/bezorgen-amstelveen/' }, { name: w.name, path: `/bezorgen-amstelveen/${w.slug}/` }]} schema={[faqLd]}>
<div class="wrap" style="padding-top:24px;padding-bottom:72px;max-width:860px">
<p class="eyebrow">Bezorgen &amp; afhalen</p>
<h1>Pizza bezorgen {loc}</h1>
{/* TODO-CONTROLEREN: valt de wijk binnen het bezorggebied in Sitedish? (Oude Dorp, Bovenkerk: w.todo) */}
<p class="lead">{w.intro}</p>
<Cta first="order" />
{w.sections.map(([h, p]) => <><h2>{h}</h2><p set:html={p} /></>)}
<h2>Wat kun je bestellen?</h2>
<p>Ruim 30 pizza’s met handgerekt deeg van onze <a href="/pizza-amstelveen/">pizzeria in Amstelveen</a>, verse <a href="/pasta-amstelveen/">pasta</a>, steaks en spare ribs van de grill, salades en desserts. Bezorgkosten, minimumbedrag en levertijd voor {w.name}{w.pc && ` (${w.pc})`} zie je direct bij het online bestellen. Bekijk de volledige <a href="/menu-italiaans-restaurant-amstelveen/">menukaart met prijzen</a>.</p>
<h2>Veelgestelde vragen over {w.name}</h2>
{w.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
<h2>Andere wijken</h2>
<p>{others.map((o, i) => <>{i > 0 && ' · '}<a href={`/bezorgen-amstelveen/${o.slug}/`}>{o.name}</a></>)} · <a href="/bezorgen-amstelveen/">Alle bezorginformatie</a></p>
</div>
</Base>
