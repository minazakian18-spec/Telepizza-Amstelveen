---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { articles } from '../../data/articles';
export const getStaticPaths = () => articles.map(a => ({ params: { slug: a.slug }, props: { a } }));
const { a } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(`/blog/${a.slug}/`, site.url).href;
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: a.title, description: a.desc, image: new URL(a.img, site.url).href, datePublished: a.date, inLanguage: 'nl', mainEntityOfPage: url, author: { '@type': 'Organization', name: site.name }, publisher: { '@id': site.url + '/#restaurant' } };
const more = articles.filter(x => x.slug !== a.slug).slice(0, 3);
---
<Base title={`${a.title} | Telepizza Amstelveen`} description={a.desc} image={a.img} crumbs={[{ name: 'Blog', path: '/blog/' }, { name: a.title, path: `/blog/${a.slug}/` }]} schema={[ld]}>
  <style>
    .art{max-width:760px;margin:0 auto;padding:24px 0 40px}
    .art time{font:500 .75rem/1 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
    .art figure{margin:36px 0}
    .art img{width:100%;aspect-ratio:16/10;object-fit:cover}
    .art .prose p{font-size:1.08rem}
    .art .prose h2{margin-top:44px}
    .cta{margin-top:48px;padding:36px;background:var(--green);color:#f3ead8;text-align:center}
    .cta p{color:#d9cfbb}
    .cta .btn:not(.primary){color:#f3ead8}
    .more{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}
    .more a{text-decoration:none}
    .more img{width:100%;aspect-ratio:4/3;object-fit:cover}
    .more h3{font-size:1.4rem;margin-top:12px}
  </style>
  <article class="wrap art">
    <time datetime={a.date}>{fmt(a.date)}</time>
    <h1>{a.title}</h1>
    <p class="lead">{a.intro}</p>
    <figure><img src={a.img} alt={a.imgAlt} width="1200" height="750" fetchpriority="high" /></figure>
    <div class="prose" set:html={a.body} />
    <div class="cta">
      <h2>Proef het zelf</h2>
      <p class="center">Telepizza Amstelveen, Amsterdamseweg 452. Dinsdag t/m zondag open vanaf 15:00.</p>
      <div class="btns" style="justify-content:center"><a class="btn primary" href={site.reserveUrl!} rel="noopener">Reserveer een tafel</a><a class="btn" href="/menu-italiaans-restaurant-amstelveen/">Bekijk de kaart</a></div>
    </div>
  </article>
  <section class="sec alt"><div class="wrap">
    <h2>Lees ook</h2>
    <div class="more">{more.map(m => <a href={`/blog/${m.slug}/`}><img src={m.img} alt={m.imgAlt} width="600" height="450" loading="lazy" decoding="async" /><h3>{m.title}</h3></a>)}</div>
  </div></section>
</Base>
