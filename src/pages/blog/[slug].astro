---
import Base from '../../layouts/Base.astro';
import { withHalalInfo } from '../../lib/halalInfo';
import { site } from '../../data/site';
import { articles } from '../../data/articles';
export const getStaticPaths = () => articles.map(a => ({ params: { slug: a.slug }, props: { a } }));
const { a } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(`/blog/${a.slug}/`, site.url).href;
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: a.title, description: a.desc, image: new URL(a.img, site.url).href, datePublished: a.date, dateModified: a.updated ?? a.date, inLanguage: 'nl', mainEntityOfPage: url, author: { '@type': 'Organization', name: site.name }, publisher: { '@id': site.url + '/#restaurant' } };
const more = articles.filter(x => x.slug !== a.slug).slice(0, 3);
const full = `${a.title} | Telepizza`;
const short = a.title.split(/[:?]/)[0].trim();
const seoTitle = full.length <= 60 ? full : a.title.length <= 60 ? a.title : `${short} | Telepizza`;
const seoDesc = a.desc;
const mains: [RegExp, string, string][] = [[/pizza/, '/pizza-amstelveen/', 'pizza in Amstelveen'], [/pasta/, '/pasta-amstelveen/', 'pasta in Amstelveen'], [/bezorg|bestel|afhal/, '/bezorgen-amstelveen/', 'eten bestellen in Amstelveen'], [/catering|feest|bedrij/, '/catering-italiaans-restaurant-amstelveen/', 'catering in Amstelveen'], [/shoarma/, '/shoarma-amstelveen/', 'shoarma in Amstelveen'], [/kapsalon/, '/kapsalon-amstelveen/', 'kapsalon in Amstelveen'], [/uit-eten|restaurant|date|verjaardag|laat|cocktail/, '/restaurant-amstelveen/', 'uit eten in ons restaurant in Amstelveen']];
const m0 = mains.find(([re]) => re.test(a.slug));
const main: [string, string] = m0 ? [m0[1], m0[2]] : ['/', 'ons Italiaans restaurant in Amstelveen'];
---
<Base title={seoTitle} description={seoDesc} image={a.img} imageAlt={a.imgAlt} crumbs={[{ name: 'Blog', path: '/blog/' }, { name: a.title, path: `/blog/${a.slug}/` }]} schema={[ld]}>
  <style>
    .art{max-width:760px;margin:0 auto;padding-top:24px;padding-bottom:40px}
    .art time{font:500 .75rem/1 var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--gold)}
    .art figure{margin:36px 0}
    .art img{width:100%;aspect-ratio:16/10;object-fit:cover}
    .art .prose p{font-size:1.08rem}
    .art .prose h2{margin-top:44px}
    .cta{margin-top:48px;padding:36px;background:var(--green);color:#f3ead8;text-align:center}
    .cta p{color:#d9cfbb}
    .cta .btn:not(.primary){color:#f3ead8}
    .more{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}
    .more a{text-decoration:none}
    .more img{width:100%;aspect-ratio:4/3;object-fit:cover}
    .more h3{font-size:1.4rem;margin-top:12px}
  </style>
  <article class="wrap art">
    <p class="meta">Door {site.name} · <time datetime={a.date}>{fmt(a.date)}</time>{a.updated && <> · bijgewerkt <time datetime={a.updated}>{fmt(a.updated)}</time></>}</p>
    <h1>{a.title}</h1>
    <p class="lead">{a.intro}</p>
    <figure><img src={a.img} alt={a.imgAlt} width="1200" height="750" fetchpriority="high" /></figure>
    <div class="prose" set:html={withHalalInfo(a.body)} />
    <div class="cta">
      <h2>Proef het zelf</h2>
      <p class="center">Meer weten? Lees over <a href={main[0]}>{main[1]}</a>, of kom langs aan de Amsterdamseweg 452. Dinsdag t/m zondag open vanaf 14:45.</p>
      <div class="btns" style="justify-content:center"><a class="btn primary" href={site.reserveUrl!} rel="noopener">Reserveer een tafel</a><a class="btn" href="/menu-italiaans-restaurant-amstelveen/">Bekijk de kaart</a></div>
    </div>
  </article>
  <section class="sec alt"><div class="wrap">
    <h2>Lees ook</h2>
    <div class="more">{more.map(m => <a href={`/blog/${m.slug}/`}><img src={m.img} alt={m.imgAlt} width="600" height="450" loading="lazy" decoding="async" /><h3>{m.title}</h3></a>)}</div>
  </div></section>
</Base>
