---
// Klantaccount via Supabase (EU). De publieke sleutel mag in de browser; rijen zijn afgeschermd met row level security.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Mijn account | Telepizza Amstelveen" description="Maak een account aan bij Telepizza Amstelveen, log in en beheer je e-mailadres, telefoonnummer en adres." crumbs={[{ name: 'Mijn account', path: '/account/' }]} noindex>
<div class="wrap acct" id="acct" data-url={site.supabase.url} data-key={site.supabase.key} style="padding-top:24px;padding-bottom:72px">
  <h1>Mijn account</h1>
  <p class="msg" id="msg" role="status" hidden></p>

  <section data-view="login">
    <h2>Inloggen</h2>
    <form id="f-login">
      <label>E-mailadres<input name="email" type="email" autocomplete="email" required /></label>
      <label>Wachtwoord<input name="password" type="password" autocomplete="current-password" required /></label>
      <button class="btn primary" type="submit">Inloggen</button>
    </form>
    <p><button class="lnkb" type="button" data-go="reset">Wachtwoord vergeten?</button></p>
    <p>Nog geen account? <button class="lnkb" type="button" data-go="register">Account aanmaken</button></p>
  </section>

  <section data-view="register" hidden>
    <h2>Account aanmaken</h2>
    <form id="f-register">
      <label>E-mailadres<input name="email" type="email" autocomplete="email" required /></label>
      <label>Wachtwoord (minimaal 8 tekens)<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label>
      <label>Telefoonnummer<input name="phone" type="tel" autocomplete="tel" pattern="\+?[0-9 ()\-]{8,20}" required /></label>
      <label>Straat en huisnummer<input name="street" autocomplete="street-address" minlength="3" maxlength="120" required /></label>
      <label>Postcode<input name="postal_code" autocomplete="postal-code" pattern="[1-9][0-9]{3} ?[A-Za-z]{2}" title="Bijvoorbeeld 1181 BW" required /></label>
      <label>Plaats<input name="city" autocomplete="address-level2" minlength="2" maxlength="80" required /></label>
      <label class="chk"><input type="checkbox" required /><span>Ik ga akkoord met de <a href={site.privacyUrl}>privacyverklaring</a>.</span></label>
      <button class="btn primary" type="submit">Account aanmaken</button>
    </form>
    <p>Heb je al een account? <button class="lnkb" type="button" data-go="login">Inloggen</button></p>
  </section>

  <section data-view="reset" hidden>
    <h2>Wachtwoord vergeten</h2>
    <form id="f-reset">
      <label>E-mailadres<input name="email" type="email" autocomplete="email" required /></label>
      <button class="btn primary" type="submit">Stuur herstellink</button>
    </form>
    <p><button class="lnkb" type="button" data-go="login">Terug naar inloggen</button></p>
  </section>

  <section data-view="newpass" hidden>
    <h2>Nieuw wachtwoord</h2>
    <form id="f-newpass">
      <label>Nieuw wachtwoord (minimaal 8 tekens)<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label>
      <button class="btn primary" type="submit">Wachtwoord opslaan</button>
    </form>
  </section>

  <section data-view="profile" hidden>
    <h2>Mijn gegevens</h2>
    <form id="f-profile">
      <label>E-mailadres<input name="email" type="email" autocomplete="email" required /></label>
      <label>Telefoonnummer<input name="phone" type="tel" autocomplete="tel" pattern="\+?[0-9 ()\-]{8,20}" required /></label>
      <label>Straat en huisnummer<input name="street" autocomplete="street-address" minlength="3" maxlength="120" required /></label>
      <label>Postcode<input name="postal_code" autocomplete="postal-code" pattern="[1-9][0-9]{3} ?[A-Za-z]{2}" title="Bijvoorbeeld 1181 BW" required /></label>
      <label>Plaats<input name="city" autocomplete="address-level2" minlength="2" maxlength="80" required /></label>
      <button class="btn primary" type="submit">Opslaan</button>
    </form>
    <div class="btns acts">
      <button class="btn" type="button" id="logout">Uitloggen</button>
      <button class="btn" type="button" id="delete">Account verwijderen</button>
    </div>
  </section>
</div>
<style>
  .acct{max-width:560px}
  .acct form{display:grid;gap:14px}
  .acct label{display:grid;gap:6px;font-weight:600;font-size:.9rem}
  .acct input:not([type=checkbox]){font:inherit;font-weight:400;padding:10px 12px;border:2px solid var(--ink);border-radius:10px;background:#fff;color:var(--ink);width:100%}
  .acct .chk{display:flex;gap:8px;align-items:flex-start;font-weight:400}
  .acct .chk input{width:18px;height:18px;margin-top:2px;flex:none;accent-color:var(--red)}
  .acct .btn{justify-content:center}
  .lnkb{border:0;background:none;padding:0;font:inherit;color:inherit;text-decoration:underline;cursor:pointer}
  .msg{background:#fffaf2;border:2px solid var(--ink);border-radius:10px;padding:12px 14px}
  .msg.err{border-color:#a81c13;color:#a81c13}
  .acts{margin-top:28px}
</style>
<script>
  import { createClient } from '@supabase/supabase-js';
  const root = document.getElementById('acct')!;
  const sb = createClient(root.dataset.url!, root.dataset.key!);
  const form = (id: string) => document.getElementById(id) as HTMLFormElement;
  const val = (f: HTMLFormElement, n: string) => (f.elements.namedItem(n) as HTMLInputElement).value.trim();
  const msgEl = document.getElementById('msg')!;
  const here = location.origin + location.pathname;

  function say(text: string, err = false) { msgEl.textContent = text; msgEl.hidden = !text; msgEl.classList.toggle('err', err); }
  function show(v: string) { root.querySelectorAll<HTMLElement>('[data-view]').forEach(s => { s.hidden = s.dataset.view !== v; }); }
  function fail(e: { message?: string; code?: string }) {
    const c = e.code || '';
    const t = c === 'invalid_credentials' ? 'E-mailadres of wachtwoord klopt niet.'
      : c === 'email_not_confirmed' ? 'Bevestig eerst je e-mailadres via de link in je mail.'
      : c === 'over_email_send_rate_limit' ? 'Er zijn te veel e-mails verstuurd. Probeer het later opnieuw.'
      : c === 'weak_password' ? 'Kies een sterker wachtwoord.'
      : 'Er ging iets mis. Controleer je gegevens en probeer het opnieuw.';
    say(t, true);
  }
  // Voorkomt dubbel versturen terwijl een verzoek loopt.
  function onSubmit(id: string, fn: (f: HTMLFormElement) => Promise<void>) {
    const f = form(id);
    f.addEventListener('submit', async e => {
      e.preventDefault();
      const b = f.querySelector('button[type=submit]') as HTMLButtonElement;
      b.disabled = true; say('');
      try { await fn(f); } catch { fail({}); }
      b.disabled = false;
    });
  }
  const address = (f: HTMLFormElement) => ({ phone: val(f, 'phone'), street: val(f, 'street'), postal_code: val(f, 'postal_code'), city: val(f, 'city') });

  async function openProfile() {
    const { data: { user } } = await sb.auth.getUser();
    if (!user) return show('login');
    const { data, error } = await sb.from('profiles').select('phone, street, postal_code, city').eq('id', user.id).single();
    if (error) fail(error);
    const f = form('f-profile');
    const values: Record<string, string> = { email: user.email ?? '', ...(data ?? {}) };
    for (const [k, v] of Object.entries(values)) (f.elements.namedItem(k) as HTMLInputElement).value = v;
    show('profile');
  }

  root.addEventListener('click', e => {
    const go = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
    if (go) { say(''); show(go.dataset.go!); }
  });

  onSubmit('f-login', async f => {
    const { error } = await sb.auth.signInWithPassword({ email: val(f, 'email'), password: (f.elements.namedItem('password') as HTMLInputElement).value });
    if (error) return fail(error);
    f.reset(); await openProfile();
  });
  onSubmit('f-register', async f => {
    const { data, error } = await sb.auth.signUp({
      email: val(f, 'email'), password: (f.elements.namedItem('password') as HTMLInputElement).value,
      options: { data: address(f), emailRedirectTo: here },
    });
    if (error) return fail(error);
    f.reset();
    if (data.session) return openProfile();
    show('login'); say('Bijna klaar! Check je inbox en bevestig je e-mailadres. Daarna kun je inloggen.');
  });
  onSubmit('f-reset', async f => {
    const { error } = await sb.auth.resetPasswordForEmail(val(f, 'email'), { redirectTo: here });
    if (error) return fail(error);
    f.reset(); say('Als dit e-mailadres bij ons bekend is, ontvang je een herstellink.');
  });
  onSubmit('f-newpass', async f => {
    const { error } = await sb.auth.updateUser({ password: (f.elements.namedItem('password') as HTMLInputElement).value });
    if (error) return fail(error);
    f.reset(); await openProfile(); say('Je wachtwoord is gewijzigd.');
  });
  onSubmit('f-profile', async f => {
    const { data: { user } } = await sb.auth.getUser();
    if (!user) return show('login');
    const { error } = await sb.from('profiles').update(address(f)).eq('id', user.id);
    if (error) return fail(error);
    const email = val(f, 'email');
    if (email !== user.email) {
      const r = await sb.auth.updateUser({ email }, { emailRedirectTo: here });
      if (r.error) return fail(r.error);
      return say('Je gegevens zijn opgeslagen. Bevestig je nieuwe e-mailadres via de link in je mail.');
    }
    say('Je gegevens zijn opgeslagen.');
  });
  document.getElementById('logout')!.addEventListener('click', async () => { await sb.auth.signOut(); say(''); show('login'); });
  document.getElementById('delete')!.addEventListener('click', async () => {
    if (!confirm('Weet je zeker dat je je account en gegevens definitief wilt verwijderen?')) return;
    const { error } = await sb.rpc('delete_my_account');
    if (error) return fail(error);
    await sb.auth.signOut({ scope: 'local' }); show('login'); say('Je account en gegevens zijn verwijderd.');
  });

  sb.auth.onAuthStateChange(ev => { if (ev === 'PASSWORD_RECOVERY') { say(''); show('newpass'); } });
  if (!/type=recovery/.test(location.hash)) openProfile();
</script>
</Base>
