---
import SimplePage from '../../components/SimplePage.astro';
import { foreign, type Lang } from '../../i18n/ui';
import { catering } from '../../i18n/pages';
export const getStaticPaths = () => foreign.map(lang => ({ params: { lang } }));
const lang = Astro.params.lang as Exclude<Lang, 'nl'>;
---
<SimplePage lang={lang} page="catering" copy={catering[lang]} img="/images/menu/pizza-chef.webp" />
