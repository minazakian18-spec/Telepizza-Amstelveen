---
import { existsSync } from 'node:fs';
import HalalInfo from '../../components/HalalInfo.astro';
import Base from '../../layouts/Base.astro';
import { menu } from '../../data/menu';
import { site } from '../../data/site';
import { dishes } from '../../data/dishes';
import { foreign, ui, pathFor, type Lang } from '../../i18n/ui';
import { menuPage } from '../../i18n/pages';
import { sectionNames, sectionNotes, descEn } from '../../i18n/menu';
export const getStaticPaths = () => foreign.map(lang => ({ params: { lang } }));
const lang = Astro.params.lang as Exclude<Lang, 'nl'>;
const t = ui[lang];
const c = menuPage[lang];
const sec = (n: string) => sectionNames[n]?.[lang] ?? n;
const note = (n: string) => sectionNotes[n]?.[lang] ?? descEn[n] ?? n;
const desc = (d: string) => descEn[d] ?? d;
const path = pathFor(lang, 'menu');
const menuLd = {
  '@context': 'https://schema.org', '@type': 'Menu', name: 'Menu Telepizza Amstelveen', url: new URL(path, site.url).href, inLanguage: lang,
  hasMenuSection: menu.map(s => ({ '@type': 'MenuSection', name: sec(s.name),
    hasMenuItem: s.items.map(i => ({ '@type': 'MenuItem', name: i.name, ...(i.description && { description: desc(i.description) }), ...(i.price != null && { offers: { '@type': 'Offer', price: i.price.toFixed(2), priceCurrency: 'EUR' } }) })) })),
};
const slug = (n: string) => n.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
import { eur as eurL, dishName, notHalalLabel } from '../../data/dishes';
const eur = (p: number) => eurL(p, lang);
// Foto alleen bij een exacte naam, zodat een pizza nooit de foto van de pasta met dezelfde naam krijgt (en andersom).
const norm = (n: string) => n.toLowerCase().replace(/[^a-z]/g, '');
const photos = new Map(Object.values(dishes).map(d => [norm(d.name), d.img]));
// Eigen foto via de upload-workflow (npm run photos): public/images/menu/<slug>.webp gaat voor op de vaste koppeling.
const photoOf = (n: string) => existsSync(`public/images/menu/${slug(n)}.webp`) ? slug(n) : photos.get(norm(n));
const sectionPhoto: Record<string, string> = { 'Pasta’s': 'pasta-tartufo', 'Speciale Pizza’s': 'pizza-truffel', 'Pizza’s met vlees': 'pizza-pepperoni', 'Vegetarische Pizza’s': 'pizza-margherita', 'Pizza’s met vis': 'pizza-gamberoni', 'Schotels': 'shoarma-schotel', 'Vleesgerechten': 'spare-ribs', 'Burgers': 'bacon-burger', 'IJs & dessert': 'tiramisu', 'Salades': 'caprese', 'Soepen': 'tomatensoep', 'Calzone’s': 'calzone' };
---
<Base lang={lang} page="menu" title={c.title} description={c.desc} crumbs={[{ name: t.nav.menu, path }]} schema={[menuLd]}>
  <style>
    .mh{padding-top:20px;padding-bottom:40px}
    .chips{position:sticky;top:78px;z-index:20;background:var(--bg);border-block:2px solid var(--ink)}
    .chips ul{display:flex;gap:8px;overflow-x:auto;list-style:none;margin:0;padding:12px 0;scrollbar-width:none}
    .chips a{display:inline-flex;align-items:center;min-height:40px;white-space:nowrap;padding:0 14px;border:2px solid var(--ink);text-decoration:none;font:800 .78rem/1 var(--head);letter-spacing:.06em;text-transform:uppercase}
    .chips a:hover{background:var(--red);border-color:var(--red);color:#fff}
    .msec{padding:56px 0 8px;scroll-margin-top:140px}
    .msec header{display:grid;gap:20px;align-items:end;margin-bottom:22px}
    @media(min-width:800px){.msec header.ph{grid-template-columns:1fr 320px}}
    .cat-ph{position:relative;margin:0}
    .cat-ph img{width:100%;aspect-ratio:16/7;object-fit:cover;border-radius:var(--r);background:#f4ede3;filter:saturate(.9)}
    .cat-ph figcaption{position:absolute;left:12px;bottom:12px;padding:6px 12px;border-radius:999px;background:rgba(20,20,20,.75);color:#fff;font:800 .72rem/1 var(--head);letter-spacing:.08em;text-transform:uppercase}
    .msec header.ph{margin-bottom:30px;grid-template-columns:1fr!important}
    .cat-ph img{max-height:260px}
    .msec h2{margin:0}
    .items{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(min(100%,420px),1fr))}
    .it{display:flex;gap:14px;align-items:center;min-height:92px;padding:14px 0;border-bottom:2px solid var(--ink)}
    .it img{width:84px;height:64px;object-fit:cover;border-radius:10px;flex:none;background:#f4ede3}
    .it div{flex:1;min-width:0}
    .it h3{font-size:1.08rem;margin:0}
    .it .nh{display:inline-block;margin-inline-start:8px;padding:3px 8px;border-radius:999px;background:#141414;color:#fff;font:800 .62rem/1.2 var(--head);letter-spacing:.06em;text-transform:uppercase;vertical-align:middle}
    .it p{margin:2px 0 0;font-size:.88rem;line-height:1.45}
    .it .price{white-space:nowrap;font-size:1.1rem}
  </style>
  <div class="wrap mh">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    <p class="menu-halal"><HalalInfo lang={lang} /></p>
    {t.descNote && <p><em>{t.descNote}</em></p>}
    <div class="btns"><a class="btn primary" href={site.orderUrl!} rel="noopener">{t.order}</a><a class="btn" href={site.reserveUrl!} rel="noopener">{t.reserve}</a></div>
  </div>
  <nav class="chips" aria-label={t.nav.menu}><div class="wrap"><ul>{menu.map(s => <li><a href={'#' + slug(s.name)}>{sec(s.name)}</a></li>)}</ul></div></nav>
  <div class="wrap">
    {menu.map(s => (
      <section class="msec" id={slug(s.name)}>
        <header class:list={{ ph: !!sectionPhoto[s.name] }}>
          <div><h2>{sec(s.name)}</h2>{s.note && <p>{note(s.note)}</p>}</div>
          {sectionPhoto[s.name] && <figure class="cat-ph"><img src={`/images/menu/${sectionPhoto[s.name]}.webp`} alt={`Sfeerfoto ${sec(s.name)} bij Telepizza Amstelveen`} width="630" height="450" loading="lazy" decoding="async" /><figcaption>{sec(s.name)}</figcaption></figure>}
        </header>
        <div class="items">
          {s.items.map(i => { const img = photoOf(i.name); return (
            <article class="it">
              {img && <img src={`/images/menu/${img}.webp`} alt={`${i.name} bij Telepizza Amstelveen`} width="84" height="64" loading="lazy" decoding="async" />}
              <div><h3>{dishName[i.name]?.[lang] ?? i.name}{i.notHalal && <><span class="sr-only"> – </span><span class="nh">{notHalalLabel[lang] ?? notHalalLabel.en}</span></>}</h3>{i.description && <p lang="en">{desc(i.description)}</p>}</div>{" "}
              <span class="price" dir="ltr">{i.priceText ?? (i.price != null ? eur(i.price) : '')}</span>
            </article>); })}
        </div>
      </section>
    ))}
    <p style="margin-top:48px">{c.outro} <a href={'tel:' + site.phone} dir="ltr">{site.phoneDisplay}</a></p>
  </div>
</Base>
