---
// Nieuwsbrief-inschrijving via Brevo (double opt-in). De kortingscode staat alleen in de welkomstmail, nooit op de site.
// variant "popup": kaart rechtsonder (desktop) of paneel boven de actiebalk (mobiel); verschijnt na delaySeconds of scrollPercent.
// variant "footer": vaste inschrijfbalk. Zonder JavaScript post het formulier gewoon naar Brevo.
// TODO-CONTROLEREN: veldnamen EMAIL, FIRSTNAME, OPT_IN, email_address_check en locale vergelijken met de echte Brevo-HTML-code.
import { site } from '../data/site';
import { nlt, type Lang } from '../i18n/ui';
interface Props { lang: Lang; variant: 'popup' | 'footer' }
const { lang, variant } = Astro.props;
const n = site.newsletter;
const c = nlt(lang);
const id = `nl-${variant}`;
const privacy = lang === 'nl' ? site.privacyUrl : '/en/privacy/';
---
{n.formAction && (
  <div class:list={['nl', `nl--${variant}`]} id={variant === 'popup' ? 'nlpop' : undefined} hidden={variant === 'popup'}
    role={variant === 'popup' ? 'dialog' : undefined} aria-labelledby={`${id}-t`} aria-modal={variant === 'popup' ? 'false' : undefined}>
    {variant === 'popup' && <button class="nl-x" type="button" aria-label={c.close}>×</button>}
    <svg class="nl-sprig" viewBox="0 0 60 18" width="44" height="13" aria-hidden="true"><path d="M2 11c12-1 24-1 56-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><ellipse cx="18" cy="6" rx="5" ry="2.2" transform="rotate(-35 18 6)" /><ellipse cx="20" cy="15" rx="5" ry="2.2" transform="rotate(30 20 15)" /><ellipse cx="31" cy="4.5" rx="5" ry="2.2" transform="rotate(-35 31 4.5)" /><ellipse cx="33" cy="14" rx="5" ry="2.2" transform="rotate(30 33 14)" /><ellipse cx="45" cy="5.5" rx="5" ry="2.2" transform="rotate(-25 45 5.5)" /><ellipse cx="55" cy="8" rx="5.5" ry="2.4" /></svg>
    <h2 id={`${id}-t`}>{variant === 'popup' ? c.title : c.footerTitle}</h2>
    {variant === 'popup' && <p>{c.text}</p>}
    <form class="nl-f" action={n.formAction} method="post" data-nl>
      <div class="nl-row">
        <label><span>{c.email}</span><input name="EMAIL" type="email" autocomplete="email" required /></label>
        <label><span>{c.first}</span><input name="FIRSTNAME" autocomplete="given-name" /></label>
      </div>
      <input class="nl-hp" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="locale" value={lang} />
      <label class="nl-ok"><input type="checkbox" name="OPT_IN" value="1" required /><span>{c.consent} <a href={privacy}>{c.privacy}</a></span></label>
      <button class="btn primary" type="submit">{c.submit}</button>
      <p class="nl-s">{c.small}</p>
    </form>
    <p class="nl-done" hidden role="status">{c.thanks}</p>
  </div>
)}
{n.formAction && variant === 'popup' && (
  <script is:inline define:vars={{ d: n.delaySeconds, sp: n.scrollPercent, hd: n.hideDays }}>
addEventListener('load', function () {
  var p = document.getElementById('nlpop'), K = 'tp-nl', last;
  function get() { try { return localStorage.getItem(K); } catch (e) { return null; } }
  function set(v) { try { localStorage.setItem(K, v); } catch (e) {} }
  function blocked() { var v = get(); return v === 'done' || (v && +v > Date.now()); }
  function consentOpen() { var c = document.getElementById('consent'); return c && !c.hidden; }
  function show(force) {
    if (!p.hidden || (!force && blocked())) return;
    if (!force && consentOpen()) return setTimeout(function () { show(); }, 2000);
    last = document.activeElement; p.hidden = false;
    requestAnimationFrame(function () { p.classList.add('in'); var i = p.querySelector('input[name=EMAIL]'); if (i) i.focus(); });
  }
  function hide(done) {
    if (p.hidden) return;
    set(done ? 'done' : String(Date.now() + hd * 864e5));
    p.classList.remove('in'); p.hidden = true; if (last && last.focus) last.focus();
  }
  if (!blocked()) {
    var t = setTimeout(show, d * 1000);
    addEventListener('scroll', function f() {
      var h = document.documentElement, pct = (scrollY + innerHeight) / h.scrollHeight * 100;
      if (pct >= sp) { clearTimeout(t); removeEventListener('scroll', f); show(); }
    }, { passive: true });
  }
  p.querySelector('.nl-x').onclick = function () { hide(); };
  addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
  document.addEventListener('click', function (e) {
    var o = e.target.closest && e.target.closest('[data-nl-open]');
    if (o) { e.preventDefault(); show(true); return; }
    if (!p.hidden && !p.contains(e.target)) hide();
  });
  document.querySelectorAll('form[data-nl]').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      if (f.email_address_check.value) return;
      fetch(f.action, { method: 'POST', body: new FormData(f), mode: 'no-cors' }).catch(function () {});
      f.hidden = true; f.parentNode.querySelector('.nl-done').hidden = false; set('done');
      if (window.gtag && window.__tpGa) gtag('event', 'newsletter_signup');
      if (f.closest('#nlpop')) setTimeout(function () { p.classList.remove('in'); p.hidden = true; }, 6000);
    });
  });
});
  </script>
)}
<style>
  .nl{background:#fffaf2;color:var(--ink);border:2px solid var(--ink);border-radius:18px;padding:20px;position:relative}
  .nl h2{font-size:1.25rem;margin:4px 0 6px;padding-inline-end:28px}
  .nl p{font-size:.92rem;margin:0 0 12px}
  .nl-sprig{color:#0B7A3B;fill:#0B7A3B;display:block}
  .nl-row{display:grid;gap:10px}
  .nl label span{display:block;font-size:.78rem;font-weight:600;margin-bottom:4px}
  .nl input[type=email],.nl input[name=FIRSTNAME]{width:100%;font:inherit;padding:10px 12px;border:2px solid var(--ink);border-radius:10px;background:#fff;color:var(--ink)}
  .nl .nl-ok{display:flex;gap:8px;align-items:flex-start;margin:12px 0;font-size:.82rem}
  .nl .nl-ok span{display:inline;font-weight:400;font-size:.82rem;margin:0}
  .nl .nl-ok input{width:18px;height:18px;margin-top:2px;flex:none;accent-color:var(--red)}
  .nl .btn{width:100%;justify-content:center}
  .nl .nl-s{font-size:.75rem;color:var(--muted);margin:10px 0 0}
  .nl-hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
  .nl-x{position:absolute;top:10px;inset-inline-end:10px;width:36px;height:36px;border:0;background:none;font-size:1.6rem;line-height:1;cursor:pointer;color:var(--ink)}
  .nl--popup{position:fixed;z-index:70;inset-inline-end:16px;bottom:78px;width:min(380px,calc(100vw - 32px));box-shadow:0 18px 50px rgba(40,20,10,.25);opacity:0;transform:translateY(16px);transition:opacity .25s,transform .25s;max-height:calc(100vh - 110px);overflow:auto}
  .nl--popup.in{opacity:1;transform:none}
  @media(max-width:600px){
    .nl--popup{left:12px;right:12px;width:auto;bottom:72px;max-height:60vh;border-radius:18px 18px 14px 14px}
  }
  .nl--footer{background:transparent;color:inherit;border-color:currentColor;margin-top:32px}
  .nl--footer .nl-sprig{display:none}
  .nl--footer .nl-s{color:inherit}
  @media(min-width:760px){.nl--footer .nl-row{grid-template-columns:1fr 1fr}}
  @media(prefers-reduced-motion:reduce){.nl--popup{transition:none}}
</style>
