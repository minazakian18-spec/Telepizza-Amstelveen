---
// Reviewsectie: één uitgelichte review groot in het rood, daarnaast vier kortere reviews als kaarten,
// en bovenaan de score van Google en TheFork. Reviewteksten zijn letterlijk overgenomen.
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';
const { lang = 'nl' } = Astro.props as { lang?: Lang };
const t = ui[lang];
const ordered = lang === 'nl' ? site.reviews : [...site.reviews].sort((a, b) => Number(b.lang === lang || b.lang === 'en') - Number(a.lang === lang || a.lang === 'en'));
// Uitgelicht: de review over het familiebedrijf als die er is, anders de eerste.
const featured = ordered.find(r => r.author === 'René Nobel') ?? ordered[0];
const rest = ordered.filter(r => r !== featured).slice(0, 4);
const fmt = (n: number) => n.toLocaleString(lang === 'en' ? 'en-GB' : 'nl-NL');
const fork = site.platforms.find(p => p.id === 'thefork');
const score = String(site.rating.value).replace('.', ',');
const L: Record<string, { reviews: string }> = { nl: { reviews: 'reviews' }, en: { reviews: 'reviews' }, de: { reviews: 'Bewertungen' }, fr: { reviews: 'avis' }, it: { reviews: 'recensioni' }, es: { reviews: 'reseñas' } };
const l = L[lang] ?? L.en;
const colors = ['#1a73e8', '#d93025', '#188038', '#e37400', '#9334e6', '#12b5cb', '#c5221f', '#5f6368'];
const colorOf = (n: string) => colors[[...n].reduce((a, c) => a + c.charCodeAt(0), 0) % colors.length];
const ld = {
  '@context': 'https://schema.org', '@type': 'Restaurant', '@id': site.url + '/#restaurant',
  review: site.reviews.map(r => ({ '@type': 'Review', author: { '@type': 'Person', name: r.author }, reviewBody: r.text, reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 } })),
};
const g = (s: number) => `<svg viewBox="0 0 48 48" width="${s}" height="${s}" aria-hidden="true"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8a10 10 0 0 1-4.4 6.6v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.1z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.4l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.6-3.9-12.3-9H4.4v5.7A22 22 0 0 0 24 46z"/><path fill="#FBBC05" d="M11.7 28.2a13.2 13.2 0 0 1 0-8.4v-5.7H4.4a22 22 0 0 0 0 19.8l7.3-5.7z"/><path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3A22 22 0 0 0 4.4 14.1l7.3 5.7c1.7-5.1 6.6-9 12.3-9z"/></svg>`;
---
<section class="rvs" aria-labelledby="rv-t">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="wrap">
    <header class="rv-top">
      <p class="eyebrow">{t.reviewsEyebrow}</p>
      <h2 id="rv-t">{t.reviewsTitle}</h2>
      <div class="rv-scores">
        <a href={site.googleReviewsUrl} rel="noopener" target="_blank"><Fragment set:html={g(22)} /><b>{score}</b><span class="rv-st" aria-hidden="true">★★★★★</span><small>{fmt(site.rating.count)} {l.reviews}</small></a>
        {fork && <a href={fork.url} rel="noopener" target="_blank"><span class="rv-fk">TheFork</span><b>{fork.score}/{fork.max}</b><small>{fmt(fork.count)} {l.reviews}</small></a>}
      </div>
    </header>

    <div class="rv-grid">
      <figure class="rv-feat">
        <span class="rv-st big" aria-label="5 / 5">★★★★★</span>
        <blockquote lang={featured.lang}>{featured.text}</blockquote>
        <figcaption>
          <span class="rv-av" style={`--c:${colorOf(featured.author)}`} aria-hidden="true">{featured.author.charAt(0).toUpperCase()}</span>
          <span><b>{featured.author}</b><small><Fragment set:html={g(13)} /> {t.googleReview}</small></span>
        </figcaption>
      </figure>
      {rest.map(r => (
        <figure class="rv-card">
          <span class="rv-st" aria-label="5 / 5">★★★★★</span>
          <blockquote lang={r.lang}>{r.text}</blockquote>
          <figcaption>
            <span class="rv-av" style={`--c:${colorOf(r.author)}`} aria-hidden="true">{r.author.charAt(0).toUpperCase()}</span>
            <span><b>{r.author}</b><small><Fragment set:html={g(13)} /> {t.googleReview}</small></span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="rv-more"><a class="btn" href={site.googleReviewsUrl} rel="noopener" target="_blank">{t.reviewsAll}</a></p>
  </div>
</section>
<style>
  .rvs{padding:96px 0;background:#f3e6d3}
  .rv-top{text-align:center;margin-bottom:44px}
  .rv-top h2{margin:6px 0 22px}
  .rv-scores{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 28px}
  .rv-scores a{display:inline-flex;align-items:center;gap:8px;color:var(--ink);text-decoration:none;font-size:.95rem}
  .rv-scores b{font:900 1.5rem/1 var(--head)}
  .rv-scores small{color:#6b5a4a;font-size:.88rem}
  .rv-fk{font:800 .95rem/1 var(--head);color:#00665c}
  .rv-st{color:#f2a900;letter-spacing:2px;font-size:1rem;line-height:1}
  .rv-grid{display:grid;gap:18px}
  @media(min-width:900px){.rv-grid{grid-template-columns:1.25fr 1fr 1fr;grid-template-rows:auto auto}.rv-feat{grid-row:span 2}}
  .rv-grid figure{margin:0;display:flex;flex-direction:column;gap:14px;border-radius:20px}
  .rv-feat{background:var(--red);color:#fff;padding:36px 34px;justify-content:space-between}
  .rv-feat .rv-st{color:#ffd166}
  .rv-st.big{font-size:1.4rem}
  .rv-feat blockquote{margin:0;font:600 clamp(1.2rem,1.7vw,1.45rem)/1.5 var(--sans)}
  .rv-card{background:#fff;padding:24px;box-shadow:0 1px 0 rgba(74,46,30,.08),0 14px 32px rgba(74,46,30,.08)}
  .rv-card blockquote{margin:0;font-size:1rem;line-height:1.6;color:#3b2d24;display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden;flex:1}
  .rv-grid figcaption{display:flex;align-items:center;gap:12px}
  .rv-grid figcaption>span:last-child{display:flex;flex-direction:column;gap:3px}
  .rv-grid figcaption b{font:700 1rem/1.2 var(--sans)}
  .rv-grid figcaption small{display:flex;align-items:center;gap:5px;font-size:.8rem;color:#6b5a4a}
  .rv-feat figcaption small{color:#ffe1dc}
  .rv-feat figcaption small svg{background:#fff;border-radius:50%;padding:1px}
  .rv-av{display:grid;place-items:center;width:42px;height:42px;flex:none;border-radius:50%;background:var(--c);color:#fff;font:600 1.1rem/1 var(--sans)}
  .rv-feat .rv-av{box-shadow:0 0 0 3px rgba(255,255,255,.35)}
  .rv-more{text-align:center;margin:36px 0 0}
</style>
