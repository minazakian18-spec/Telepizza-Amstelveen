---
// Logo in de stijl van het officiële Telepizza-logo: stenen oven met vlam, Italiaanse vlaglijnen,
// woordmerk TELE/PIZZA (HTML-tekst in Archivo, scherpst), ondertitel en olijftakje.
// Kleuren via --logo-green / --logo-red / --logo-ink in theme.css.
interface Props { variant?: 'header' | 'full' | 'image'; href: string; since?: string }
const { variant = 'header', href, since } = Astro.props;
---
{variant === 'image' ? (
  <a class="logo logo--image" href={href}><img src="/images/logo-telepizza.webp" srcset="/images/logo-telepizza.webp 360w, /images/logo-telepizza-2x.webp 720w" sizes="220px" width="220" height="220" alt="Telepizza, est. 1984" loading="lazy" decoding="async" /></a>
) : (
<a class:list={['logo', `logo--${variant}`]} href={href}>
  <span class="lg-top" aria-hidden="true">
    <span class="lg-line lg-green"></span>
    <svg class="lg-oven" viewBox="0 0 64 44" width="64" height="44">
      <path class="lg-arch" d="M11 37V27a21 21 0 0 1 42 0v10" fill="none" stroke-width="8" pathLength="100" stroke-dasharray="9.4 1.7" stroke-dashoffset="0" />
      <path class="lg-flame" fill-rule="evenodd" d="M32 15c1 4 6 6 7 11 1 5-2 9-7 9s-8-4-7-8c.5-2.5 2-4 3-5 0 2 1 3 2 3-.5-3 0-6 2-10zm0 11c-1 2-3 3-3 5a3 3 0 0 0 6 0c0-1.5-1-2.5-1.5-3.5-.3 1-.8 1.5-1.5 1.5.3-1 .3-2 0-3z" />
      <rect class="lg-plate" x="5" y="39" width="54" height="4" rx="1" />
    </svg>
    <span class="lg-line lg-red"></span>
  </span>
  <b>Telepizza</b>{" "}
  <small>Est. 1984</small>
  <svg class="lg-sprig" viewBox="0 0 60 18" width="60" height="18" aria-hidden="true">
    <path d="M2 11c12-1 24-1 56-3" fill="none" stroke-width="1.6" stroke-linecap="round" />
    <ellipse cx="18" cy="6" rx="5" ry="2.2" transform="rotate(-35 18 6)" />
    <ellipse cx="20" cy="15" rx="5" ry="2.2" transform="rotate(30 20 15)" />
    <ellipse cx="31" cy="4.5" rx="5" ry="2.2" transform="rotate(-35 31 4.5)" />
    <ellipse cx="33" cy="14" rx="5" ry="2.2" transform="rotate(30 33 14)" />
    <ellipse cx="45" cy="5.5" rx="5" ry="2.2" transform="rotate(-25 45 5.5)" />
    <ellipse cx="55" cy="8" rx="5.5" ry="2.4" />
  </svg>
</a>
)}
