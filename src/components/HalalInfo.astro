---
// "Halal vlees ⓘ": korte halalvermelding met een uitlegpopover (zelfde HTML als halalInfoHtml in src/lib/halalInfo.ts).
import type { Lang } from '../i18n/ui';
import { halalInfoHtml } from '../lib/halalInfo';
const { lang = 'nl', label } = Astro.props as { lang?: Lang; label?: string };
---
<Fragment set:html={halalInfoHtml(lang, label)} />
<style is:global>
  .hi{position:relative;display:inline-flex;align-items:center;gap:2px;vertical-align:baseline}
  .hi-btn{display:inline-grid;place-items:center;width:32px;height:32px;margin:-8px -6px -8px -4px;border:0;background:none;padding:0;cursor:pointer;color:inherit;text-decoration:none;font:inherit}
  .hi-btn span{display:grid;place-items:center;width:17px;height:17px;border-radius:50%;border:1.5px solid currentColor;font:700 .7rem/1 Georgia,serif;font-style:italic;opacity:.85}
  .hi-btn:hover span,.hi-btn[aria-expanded="true"] span{opacity:1;border-width:2px}
  .hi-pop{position:fixed;z-index:80;top:0;left:0;width:min(300px,calc(100vw - 24px));padding:14px 16px;border-radius:12px;background:#fff;color:#202124;box-shadow:0 12px 32px rgba(0,0,0,.22);font:400 .88rem/1.5 var(--sans);text-align:start;text-transform:none;letter-spacing:normal;white-space:normal}
  .hi-pop span{display:block;margin-bottom:6px}
  .hi-pop a{font-weight:700;color:#a81c13}
</style>
