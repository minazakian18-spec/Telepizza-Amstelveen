---
import { site } from '../data/site';
import { eur, type Dish } from '../data/dishes';
interface Props { items: Dish[] }
const { items } = Astro.props;
---
<div class="dishes">
  {items.map(d => (
    <article class="dish">
      {d.tag && <span class="tag">{d.tag}</span>}
      <div class="im"><img src={`/images/menu/${d.img}.webp`} alt={`${d.name} van Telepizza Amstelveen`} width="630" height="450" loading="lazy" decoding="async" /></div>
      <div class="tx">
        <h3>{d.name}</h3>
        <p>{d.text}</p>
        <div class="row"><span class="price">{eur(d.price)}</span><a class="btn primary sm" href={site.orderUrl!} rel="noopener" aria-label={`${d.name} bestellen`}>Bestel</a></div>
      </div>
    </article>
  ))}
</div>
