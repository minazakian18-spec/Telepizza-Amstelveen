---
// Bestel- en reserveerknop naast elkaar. first bepaalt welke de rode hoofdknop is.
import { site } from '../data/site';
import { ui, type Lang } from '../i18n/ui';
interface Props { first?: 'order' | 'reserve'; lang?: Lang }
const { first = 'reserve', lang = 'nl' } = Astro.props;
const order = { href: site.orderUrl!, label: ui[lang].order };
const reserve = { href: site.reserveUrl!, label: ui[lang].reserve };
const [a, b] = first === 'order' ? [order, reserve] : [reserve, order];
---
<div class="btns">
  <a class="btn primary" href={a.href} rel="noopener">{a.label}</a>
  <a class="btn" href={b.href} rel="noopener">{b.label}</a>
</div>
