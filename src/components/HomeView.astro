---
// Homepage in de Telepizza-huisstijl; gedeeld door alle talen. Restaurant voorop, bestellen als tweede.
// Foto's in /images/ph/ zijn eigen foto's van Telepizza (bron: C:\Documents\Telepizza\Afbeeldingen).
import Base from '../layouts/Base.astro';
import Dishes from './Dishes.astro';
import Reviews from './Reviews.astro';
import ReviewBadges from './ReviewBadges.astro';
import { site } from '../data/site';
import { pick } from '../data/dishes';
import { media } from '../lib/media';
import { articles } from '../data/articles';
import { ui, pathFor, type Lang } from '../i18n/ui';
import type { HomeCopy } from '../i18n/pages';
import '../styles/home.css';
interface Props { lang: Lang; c: HomeCopy }
const { lang, c } = Astro.props;
const t = ui[lang];
const menu = pathFor(lang, 'menu');
const ph = (n: string) => `/images/ph/${n}.webp`;
const ss = (n: string) => `/images/ph/${n}-sm.webp 640w, /images/ph/${n}.webp 1200w`;
// Teksten die alleen op de homepage staan, per taal.
const local: Record<Lang, { since: string; team: string; roles: [string, string, string]; follow: string; stories: string; all: string }> = {
  nl: { since: 'Sinds 1984', team: 'Het team van Telepizza', roles: ['Chef', 'Manager & bediening', 'Marketing & gastvrijheid'], follow: 'Volg ons', stories: 'Verhalen', all: 'Alle artikelen' },
  en: { since: 'Since 1984', team: 'The Telepizza team', roles: ['Chef', 'Manager & service', 'Marketing & hospitality'], follow: 'Follow us', stories: 'Stories', all: 'All articles' },
  de: { since: 'Seit 1984', team: 'Das Team von Telepizza', roles: ['Küchenchef', 'Manager & Service', 'Marketing & Gastfreundschaft'], follow: 'Folge uns', stories: 'Geschichten', all: 'Alle Artikel' },
  tr: { since: '1984’ten beri', team: 'Telepizza ekibi', roles: ['Şef', 'Müdür & servis', 'Pazarlama & misafirperverlik'], follow: 'Bizi takip et', stories: 'Hikâyeler', all: 'Tüm yazılar' },
  ar: { since: 'منذ 1984', team: 'فريق تيليبيتزا', roles: ['الشيف', 'المدير والخدمة', 'التسويق والضيافة'], follow: 'تابعنا', stories: 'قصص', all: 'كل المقالات' },
  fr: { since: 'Depuis 1984', team: 'L’équipe Telepizza', roles: ['Chef', 'Manager & service', 'Marketing & accueil'], follow: 'Suivez-nous', stories: 'Histoires', all: 'Tous les articles' },
  it: { since: 'Dal 1984', team: 'Il team di Telepizza', roles: ['Chef', 'Manager & sala', 'Marketing & accoglienza'], follow: 'Seguici', stories: 'Storie', all: 'Tutti gli articoli' },
  es: { since: 'Desde 1984', team: 'El equipo de Telepizza', roles: ['Chef', 'Encargado & sala', 'Marketing & hospitalidad'], follow: 'Síguenos', stories: 'Historias', all: 'Todos los artículos' },
};
const L = local[lang];
const hello: Record<Lang, { t: string; p: string; sign: string; ex: string }> = {
  nl: { t: 'Welkom bij ons thuis', p: 'Sinds 1984 openen wij elke middag onze deuren aan de Amsterdamseweg. Bij ons ben je geen klantnummer: we onthouden je favoriete pizza, schuiven tafels aan elkaar voor je verjaardag en blijven open tot je klaar bent met kletsen. Of je nu uit Amstelveen komt of uit de andere kant van de wereld: schuif aan, je bent welkom.', sign: 'Het Telepizza-team', ex: 'Hotter than your ex' },
  en: { t: 'Welcome to our home', p: 'Since 1984 we have opened our doors every afternoon on the Amsterdamseweg. Here you are not a number: we remember your favourite pizza, push tables together for your birthday and stay open until you are done talking. Whether you live around the corner or came from the other side of the world: pull up a chair, you are welcome.', sign: 'The Telepizza team', ex: 'Hotter than your ex' },
  de: { t: 'Willkommen bei uns', p: 'Seit 1984 öffnen wir jeden Nachmittag unsere Türen an der Amsterdamseweg. Bei uns sind Sie keine Nummer: Wir kennen Ihre Lieblingspizza, stellen Tische für Ihren Geburtstag zusammen und haben offen, bis Sie fertig erzählt haben. Ob aus Amstelveen oder vom anderen Ende der Welt: Setzen Sie sich, Sie sind willkommen.', sign: 'Das Telepizza-Team', ex: 'Hotter than your ex' },
  tr: { t: 'Evimize hoş geldin', p: '1984’ten beri her öğleden sonra Amsterdamseweg’de kapılarımızı açıyoruz. Burada bir numara değilsin: en sevdiğin pizzayı hatırlarız, doğum günün için masaları birleştiririz ve sohbetin bitene kadar açık kalırız. İster Amstelveen’den ister dünyanın öbür ucundan gel: buyur otur, hoş geldin.', sign: 'Telepizza ekibi', ex: 'Hotter than your ex' },
  ar: { t: 'أهلاً بك في بيتنا', p: 'منذ عام 1984 نفتح أبوابنا كل ظهيرة في شارع Amsterdamseweg. هنا لست مجرد رقم: نتذكر البيتزا المفضلة لديك، ونجمع الطاولات لعيد ميلادك ونبقى مفتوحين حتى تنتهي من الحديث. سواء كنت من أمستلفين أو من الطرف الآخر من العالم: تفضل بالجلوس، أنت مرحب بك.', sign: 'فريق تيليبيتزا', ex: 'Hotter than your ex' },
  fr: { t: 'Bienvenue chez nous', p: 'Depuis 1984, nous ouvrons nos portes chaque après-midi sur l’Amsterdamseweg. Ici, vous n’êtes pas un numéro : nous connaissons votre pizza préférée, rapprochons les tables pour votre anniversaire et restons ouverts tant que vous discutez. Que vous veniez d’Amstelveen ou de l’autre bout du monde : installez-vous, vous êtes les bienvenus.', sign: 'L’équipe Telepizza', ex: 'Hotter than your ex' },
  it: { t: 'Benvenuti a casa nostra', p: 'Dal 1984 apriamo le porte ogni pomeriggio sull’Amsterdamseweg. Qui non sei un numero: ricordiamo la tua pizza preferita, uniamo i tavoli per il tuo compleanno e restiamo aperti finché hai voglia di chiacchierare. Che tu venga da Amstelveen o dall’altra parte del mondo: accomodati, sei il benvenuto.', sign: 'Il team di Telepizza', ex: 'Hotter than your ex' },
  es: { t: 'Bienvenido a nuestra casa', p: 'Desde 1984 abrimos nuestras puertas cada tarde en la Amsterdamseweg. Aquí no eres un número: recordamos tu pizza favorita, juntamos mesas para tu cumpleaños y seguimos abiertos mientras sigas charlando. Vengas de Amstelveen o del otro lado del mundo: siéntate, eres bienvenido.', sign: 'El equipo de Telepizza', ex: 'Hotter than your ex' },
};
const H = hello[lang];
const alts: Record<string, { hall: string; front: string }> = {
  nl: { hall: 'Restaurantzaal met neonverlichting en plantenwand, Telepizza aan de Amsterdamseweg in Amstelveen', front: 'Gevel van Telepizza, Italiaans restaurant en bar aan de Amsterdamseweg 452 in Amstelveen' },
  en: { hall: 'Dining room with neon lights and a green plant wall at Telepizza, Amstelveen', front: 'Front of Telepizza Italian restaurant and bar, Amsterdamseweg 452, Amstelveen' },
  de: { hall: 'Speisesaal mit Neonlicht und Pflanzenwand bei Telepizza in Amstelveen', front: 'Fassade von Telepizza, italienisches Restaurant an der Amsterdamseweg 452 in Amstelveen' },
  fr: { hall: 'Salle avec néons et mur végétal chez Telepizza à Amstelveen', front: 'Façade de Telepizza, restaurant italien au 452 Amsterdamseweg à Amstelveen' },
  it: { hall: 'Sala con luci al neon e parete verde da Telepizza ad Amstelveen', front: 'Facciata di Telepizza, ristorante italiano in Amsterdamseweg 452 ad Amstelveen' },
  es: { hall: 'Comedor con neones y pared de plantas en Telepizza, Amstelveen', front: 'Fachada de Telepizza, restaurante italiano en Amsterdamseweg 452, Amstelveen' },
};
const A = alts[lang] ?? alts.en;
const photoAlts: Record<string, Record<string, string>> = {
  nl: { 'pizza-rozemarijn': 'Pizza met salami, champignons en paprika bij Telepizza Amstelveen', 'pasta-penne': 'Penne in tomatensaus met verse kruiden bij Telepizza Amstelveen', 'pizza-hand': 'Pizza met kip, paprika en maïs bij Telepizza Amstelveen', 'pizza-rond': 'Pizza met spinazie en witte kaas bij Telepizza Amstelveen', 'pasta-vork': 'Spaghetti bolognese met verse kruiden bij Telepizza Amstelveen', neon: 'Donkere tafel met twee schaaltjes onder rood neonlicht', bar: 'Cocktail op een tafel voor de neon Hotter than your ex', 'zaal-planten': 'Groene plantenwand met neonletters en een gloeilamp' },
  en: { 'pizza-rozemarijn': 'Pizza with salami, mushrooms and peppers at Telepizza Amstelveen', 'pasta-penne': 'Penne in tomato sauce with fresh herbs at Telepizza Amstelveen', 'pizza-hand': 'Pizza with chicken, peppers and sweetcorn at Telepizza Amstelveen', 'pizza-rond': 'Pizza with spinach and white cheese at Telepizza Amstelveen', 'pasta-vork': 'Spaghetti bolognese with fresh herbs at Telepizza Amstelveen', neon: 'Dark table with two small dishes under red neon light', bar: 'Cocktail on a table in front of the Hotter than your ex neon', 'zaal-planten': 'Green plant wall with neon lettering and a light bulb' },
  de: { 'pizza-rozemarijn': 'Pizza mit Salami, Champignons und Paprika bei Telepizza Amstelveen', 'pasta-penne': 'Penne in Tomatensauce mit frischen Kräutern bei Telepizza Amstelveen', 'pizza-hand': 'Pizza mit Hähnchen, Paprika und Mais bei Telepizza Amstelveen', 'pizza-rond': 'Pizza mit Spinat und weißem Käse bei Telepizza Amstelveen', 'pasta-vork': 'Spaghetti Bolognese mit frischen Kräutern bei Telepizza Amstelveen', neon: 'Dunkler Tisch mit zwei Schälchen unter rotem Neonlicht', bar: 'Cocktail auf einem Tisch vor dem Neonschriftzug Hotter than your ex', 'zaal-planten': 'Grüne Pflanzenwand mit Neonschrift und Glühbirne' },
  fr: { 'pizza-rozemarijn': 'Pizza au salami, champignons et poivrons chez Telepizza Amstelveen', 'pasta-penne': 'Penne à la sauce tomate et herbes fraîches chez Telepizza Amstelveen', 'pizza-hand': 'Pizza au poulet, poivrons et maïs chez Telepizza Amstelveen', 'pizza-rond': 'Pizza aux épinards et fromage blanc chez Telepizza Amstelveen', 'pasta-vork': 'Spaghetti bolognaise aux herbes fraîches chez Telepizza Amstelveen', neon: 'Table sombre avec deux coupelles sous un néon rouge', bar: 'Cocktail sur une table devant le néon Hotter than your ex', 'zaal-planten': 'Mur végétal avec lettres au néon et ampoule' },
  it: { 'pizza-rozemarijn': 'Pizza con salame, funghi e peperoni da Telepizza Amstelveen', 'pasta-penne': 'Penne al pomodoro con erbe fresche da Telepizza Amstelveen', 'pizza-hand': 'Pizza con pollo, peperoni e mais da Telepizza Amstelveen', 'pizza-rond': 'Pizza con spinaci e formaggio bianco da Telepizza Amstelveen', 'pasta-vork': 'Spaghetti alla bolognese con erbe fresche da Telepizza Amstelveen', neon: 'Tavolo scuro con due ciotoline sotto una luce al neon rossa', bar: 'Cocktail su un tavolo davanti al neon Hotter than your ex', 'zaal-planten': 'Parete verde con scritte al neon e una lampadina' },
  es: { 'pizza-rozemarijn': 'Pizza con salami, champiñones y pimientos en Telepizza Amstelveen', 'pasta-penne': 'Penne con salsa de tomate y hierbas frescas en Telepizza Amstelveen', 'pizza-hand': 'Pizza con pollo, pimientos y maíz en Telepizza Amstelveen', 'pizza-rond': 'Pizza con espinacas y queso blanco en Telepizza Amstelveen', 'pasta-vork': 'Espaguetis a la boloñesa con hierbas frescas en Telepizza Amstelveen', neon: 'Mesa oscura con dos cuencos bajo luz de neón roja', bar: 'Cóctel sobre una mesa frente al neón Hotter than your ex', 'zaal-planten': 'Pared de plantas con letras de neón y una bombilla' },
};
const PA = photoAlts[lang] ?? photoAlts.en;
// Hero-slides. Een slide verschijnt alleen als het bestand in public/images/hero/ bestaat.
const heroAlt: Record<string, [string, string, string, string]> = {
  nl: ['Restaurantzaal van Telepizza Amstelveen met neon "Hotter than your ex" en plantenwand', 'Volle restaurantzaal van Telepizza Amstelveen met gasten aan lange tafels', 'Gasten eten pizza en pasta aan een lange tafel bij Telepizza Amstelveen', 'Eigenaren van Telepizza voor het restaurant aan de Amsterdamseweg 452 in Amstelveen'],
  en: ['Telepizza Amstelveen dining room with the neon "Hotter than your ex" and a plant wall', 'Busy dining room at Telepizza Amstelveen with guests at long tables', 'Guests eating pizza and pasta at a long table at Telepizza Amstelveen', 'Owners of Telepizza in front of the restaurant at Amsterdamseweg 452, Amstelveen'],
};
const HA = heroAlt[lang] ?? heroAlt.en;
const heroAll = [
  { n: 'zaal-neon', w: 1600, h: 1042, pos: '30% 40%', alt: HA[0] },
  { n: 'volle-zaal', w: 1600, h: 1837, pos: '55% 55%', alt: HA[1], todo: 'AVG' }, // TODO-CONTROLEREN: toestemming gasten op deze foto (AVG)
  { n: 'gasten-tafel', w: 1200, h: 1600, pos: '50% 45%', alt: HA[2], todo: 'AVG' }, // TODO-CONTROLEREN: toestemming gasten op deze foto (AVG)
  { n: 'gevel-eigenaren', w: 1200, h: 630, pos: '45% 40%', alt: HA[3], small: true }, // TODO-CONTROLEREN: gevelfoto in hogere resolutie (min. 1600 px breed, mét logo) aanleveren
].filter(x => media(`hero/${x.n}.webp`));
const hp = (n: string) => `/images/hero/${n}.webp`;
const hs = (n: string) => `/images/hero/${n}-sm.webp 640w, /images/hero/${n}.webp 1600w`;
// Timing: elke slide 6 seconden, ongeacht het aantal slides.
const slideSec = 6;
const cycle = heroAll.length * slideSec;
const showPct = (100 / heroAll.length).toFixed(2);
const heroCss = heroAll.length > 1 ? `@keyframes heroFade{0%{opacity:0}4%{opacity:1}${showPct}%{opacity:1}${(+showPct + 4).toFixed(2)}%{opacity:0}100%{opacity:0}}
.hero .slide{animation:heroFade ${cycle}s infinite}
${heroAll.map((x, i) => `.hero .slide:nth-of-type(${i + 1}){animation-delay:${i * slideSec}s}`).join('\n')}` : '';

const words = ['Pizza', 'Pasta', 'Grill', 'Cocktails', L.since, 'Amstelveen'];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: lang, mainEntity: c.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') } })) };
---
<Base overlay lang={lang} page="home" schema={[faqLd]} image={hp('zaal-neon')} title={c.title} description={c.desc}>
  <link slot="head" rel="preload" as="image" href={hp('zaal-neon')} imagesrcset={hs('zaal-neon')} imagesizes="100vw" fetchpriority="high" />
  {heroCss && <style slot="head" set:html={heroCss} />}
  <section class="hero" aria-label="Telepizza Amstelveen">
    {heroAll.map((x, i) => (
      <>
        <img class:list={['slide', { small: x.small }]} src={hp(x.n)} srcset={x.small ? undefined : hs(x.n)} sizes="100vw" alt={x.alt} width={x.w} height={x.h} style={`object-position:${x.pos}`}
          {...(i === 0 ? { fetchpriority: 'high' } : { loading: 'lazy', decoding: 'async' })} />
      </>
    ))}
    <div class="tagline"><span class="neon">{H.ex}</span><span>Ristorante · Pizzeria · Grill</span>
      <div class="btns hero-btns"><a class="btn primary" href={site.orderUrl!} rel="noopener">{t.order}</a><a class="btn" href={site.reserveUrl!} rel="noopener">{t.reserve}</a></div>
    </div>
  </section>

  <section class="trust"><div class="wrap">
    <ReviewBadges />
    {/* TODO-CONTROLEREN: halal-claim */}
    <p class="facts-line"><span>{L.since}</span><span>100% halal</span>{site.awards.map(a => <span>🏆 {a.label} · {a.by}</span>)}</p>
  </div></section>

  <section class="wrap intro">
    <div>
      <h1 set:html={c.h1} />
      <div class="txt">
        <p>{c.lead}</p>
        <div class="btns"><a class="btn primary" href={site.reserveUrl!} rel="noopener">{t.reserve}</a><a class="btn" href={site.orderUrl!} rel="noopener">{t.order}</a></div>
        <div class="links"><a class="lnk" href={menu}>{t.viewMenu}</a><a class="lnk" href={pathFor(lang, 'catering')}>{t.nav.catering}</a></div>
      </div>
    </div>
    <div class="stamps" aria-hidden="true">
      {c.facts.map(([b, s]) => <div class="stamp"><span>{b}<small>{s}</small></span></div>)}
    </div>
  </section>

  <section class="hello"><div class="wrap">
    <div class="note">
      <p class="script">{H.t}</p>
      <p>{H.p}</p>
      <p class="sign">— {H.sign}</p>
    </div>
    <figure class="pol"><img src={ph('gevel')} srcset={ss('gevel')} sizes="(min-width:900px) 40vw, 100vw" alt={A.front} width="1200" height="900" loading="lazy" decoding="async" /><figcaption>Amsterdamseweg 452</figcaption></figure>
  </div></section>

  <section class="overlap"><div class="wrap"><div class="box">
    <h2 set:html={c.storyTitle} />
    <p>{c.story[0]}</p>
    <div class="links"><a class="lnk" href={pathFor(lang, 'about')}>{t.nav.about}</a></div>
  </div></div></section>

  <section class="marq" aria-hidden="true">
    <img src={ph('pizza-rozemarijn')} srcset={ss('pizza-rozemarijn')} sizes="(min-width:700px) 33vw, 100vw" alt={PA['pizza-rozemarijn']} width="800" height="1000" loading="lazy" decoding="async" />
    <img src={ph('pasta-penne')} srcset={ss('pasta-penne')} sizes="(min-width:700px) 33vw, 100vw" alt={PA['pasta-penne']} width="800" height="1000" loading="lazy" decoding="async" />
    <img src={ph('pizza-hand')} srcset={ss('pizza-hand')} sizes="(min-width:700px) 33vw, 100vw" alt={PA['pizza-hand']} width="800" height="1000" loading="lazy" decoding="async" />
    <div class="words">{[...words, ...words].map(w => <span>{w} ·</span>)}</div>
  </section>

  <section class="sec green"><div class="wrap">
    <div class="head"><div><p class="eyebrow">{c.favEyebrow}</p><h2>{c.favTitle}</h2></div><a class="btn" href={menu}>{t.fullMenu}</a></div>
    <Dishes lang={lang} items={pick('telePizza', 'truffel', 'chef', 'carbonara', 'tartufo', 'salmone', 'ribs', 'lasagna', 'popeye', 'kapsalon')} />
  </div></section>

  <section class="welcome">
    <video class="full" data-src="/images/hero-video.mp4" poster={ph('neon-sm')} muted loop playsinline preload="none" aria-hidden="true"></video>
    <div class="card2">
      <p class="eyebrow">Benvenuti a Telepizza</p>
      <h2>{c.salaTitle}</h2>
      <p>{c.story[1]}</p>
      <div class="btns"><a class="btn primary" href={site.reserveUrl!} rel="noopener">{t.reserve}</a><a class="btn" href={site.orderUrl!} rel="noopener">{t.order}</a></div>
    </div>
  </section>

  <section class="sec"><div class="wrap">
    <div class="head"><h2>{c.waysTitle}</h2></div>
    <div class="occ">{c.ways.map(([h, p], i) => <div><span class="n">0{i + 1}</span><h3>{h}</h3><p set:html={p} /></div>)}</div>
  </div></section>

  <div id="reviews"><Reviews lang={lang} /></div>

  {lang === 'nl' && <section class="sec alt"><div class="wrap">
    <div class="head"><div><p class="eyebrow">Uit de keuken</p><h2>{L.stories}</h2></div><a class="btn" href="/blog/">{L.all}</a></div>
    <div class="journal">{articles.slice(0, 3).map(a => <a href={`/blog/${a.slug}/`}><img src={a.img} alt={a.imgAlt} width="800" height="800" loading="lazy" decoding="async" /><small>Blog · {new Date(a.date).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</small><h3>{a.title}</h3></a>)}</div>
  </div></section>}

  <section class="sec"><div class="wrap">
    <div class="head"><div><p class="eyebrow">{L.follow}</p><h2>@telepizza_nl</h2></div><div class="btns" style="margin-top:0">
        {site.social.instagram && <a class="btn sm" href={site.social.instagram} rel="noopener">Instagram</a>}
        {site.social.tiktok && <a class="btn sm" href={site.social.tiktok} rel="noopener">TikTok</a>}
        {site.social.facebook && <a class="btn sm" href={site.social.facebook} rel="noopener">Facebook</a>}
      </div></div>
    <div class="insta">{['neon', 'pizza-rozemarijn', 'bar', 'pizza-rond', 'pasta-vork', 'zaal-planten'].map(n => <a href="https://www.instagram.com/telepizza_nl/" rel="noopener" aria-label="Instagram"><img src={ph(n + '-sm')} alt={PA[n]} width="400" height="400" loading="lazy" decoding="async" /></a>)}</div>
    {/* TODO-CONTROLEREN: bron/link voor "300.000 views" en het krantenartikel */}
    <p style="margin-top:28px">{c.press}</p>
  </div></section>

  <section class="sec alt"><div class="wrap">
    <h2>{c.seoTitle}</h2>
    <div class="seo prose" style="margin-top:32px">{c.seo.map(([h, p]) => <><h3>{h}</h3><p set:html={p} /></>)}</div>
  </div></section>

  <section class="sec"><div class="wrap" style="max-width:900px">
    <h2>FAQ</h2>
    {c.faq.map(([q, a]) => <details><summary>{q}</summary><p set:html={a} /></details>)}
    <slot name="faqmore" />
  </div></section>
  <script is:inline>
    // Extra slides pas na het laden van de pagina; de video pas als hij in beeld komt. Zo laadt de hoofdfoto als eerste.
    (function () { var v = document.querySelector('.welcome video'); if (!v || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      new IntersectionObserver(function (e, o) { if (e[0].isIntersecting) { v.src = v.dataset.src; v.play().catch(function () {}); o.disconnect(); } }, { rootMargin: '200px' }).observe(v); })();
  </script>
</Base>
