---
// Scores van Google, TheFork, Tripadvisor en Sitedish met herkenbaar logo, vooral voor toeristen.
import { site } from '../data/site';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<ul class:list={['badges', { dark }]}>
  {site.platforms.map(p => (
    <li><a href={p.url} rel="noopener" aria-label={`${p.name}: ${p.score} van ${p.max}, ${p.count} reviews`}>
      <span class="logo" aria-hidden="true">
        {p.id === 'google' && <svg viewBox="0 0 48 48"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8a10 10 0 0 1-4.4 6.6v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.1z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.4l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.6-3.9-12.3-9H4.4v5.7A22 22 0 0 0 24 46z"/><path fill="#FBBC05" d="M11.7 28.2a13.2 13.2 0 0 1 0-8.4v-5.7H4.4a22 22 0 0 0 0 19.8l7.3-5.7z"/><path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3A22 22 0 0 0 4.4 14.1l7.3 5.7c1.7-5.1 6.6-9 12.3-9z"/></svg>}
        {p.id === 'tripadvisor' && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="23" fill="#34E0A1"/><circle cx="15" cy="26" r="7.5" fill="#fff"/><circle cx="33" cy="26" r="7.5" fill="#fff"/><circle cx="15" cy="26" r="3.6" fill="#000"/><circle cx="33" cy="26" r="3.6" fill="#000"/><path d="M8 17h32l-4 4H12z" fill="#000"/><path d="M24 31l-3 4h6z" fill="#000"/></svg>}
        {p.id === 'thefork' && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="23" fill="#00665C"/><path d="M17 11v12a4 4 0 0 0 3 3.9V37h3V26.9a4 4 0 0 0 3-3.9V11h-2.5v10h-1.5V11h-2v10H18.5V11z" fill="#fff"/><path d="M30 11c3 1 4 5 4 9s-1 6-2.5 6.5V37h-3V11z" fill="#fff"/></svg>}
        {p.id === 'sitedish' && <svg viewBox="0 0 48 48"><rect x="1" y="1" width="46" height="46" rx="12" fill="#F2652A"/><path d="M31 17c-1.5-2-4-3-7-3-4 0-7 2-7 5.5 0 7 13 4.5 13 10 0 2-2 3.5-5.5 3.5-3 0-5-1.2-6.5-3" stroke="#fff" stroke-width="3.5" fill="none" stroke-linecap="round"/></svg>}
      </span>
      <span class="txt"><b><span dir="ltr">{p.score}</span><small>/{p.max}</small></b><span>{p.name} · {p.count.toLocaleString('nl-NL')}</span></span>
    </a></li>
  ))}
</ul>
<style>
  .badges{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;list-style:none;margin:0;padding:0}
  @media(min-width:760px){.badges{grid-template-columns:repeat(4,1fr)}}
  .badges a{display:flex;align-items:center;gap:12px;padding:12px 14px;background:#fffaf2;color:var(--ink);border-radius:14px;text-decoration:none;box-shadow:0 6px 18px rgba(74,46,30,.12);transition:transform .15s}
  .badges a:hover{transform:translateY(-2px)}
  .logo svg{width:34px;height:34px;display:block}
  .txt{display:flex;flex-direction:column;line-height:1.15}
  .txt b{font:900 1.35rem/1 var(--head);color:var(--ink)}
  .txt b small{font-size:.75rem;opacity:.6;margin-inline-start:2px}
  .txt>span{font-size:.78rem;color:var(--muted);margin-top:3px}
</style>
