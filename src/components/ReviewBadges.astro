---
// Beoordelingen van Google en TheFork als twee duidelijke kaarten: logo, groot cijfer, sterren en aantal reviews.
import { site } from '../data/site';
import type { Lang } from '../i18n/ui';
const { lang = 'nl' } = Astro.props as { lang?: Lang };
const T: Record<string, { title: string; reviews: string; outOf: string }> = {
  nl: { title: 'Beoordeeld door onze gasten', reviews: 'reviews', outOf: 'van' },
  en: { title: 'Rated by our guests', reviews: 'reviews', outOf: 'out of' },
  de: { title: 'Bewertet von unseren Gästen', reviews: 'Bewertungen', outOf: 'von' },
  fr: { title: 'Notés par nos clients', reviews: 'avis', outOf: 'sur' },
  it: { title: 'Valutati dai nostri ospiti', reviews: 'recensioni', outOf: 'su' },
  es: { title: 'Valorados por nuestros clientes', reviews: 'reseñas', outOf: 'de' },
};
const t = T[lang] ?? T.en;
const fmt = (n: number) => n.toLocaleString(lang === 'en' ? 'en-GB' : 'nl-NL');
// Sterren gevuld naar verhouding: 4,7 van 5 en 9 van 10 worden 94% en 90%.
const pct = (p: { score: string; max: string }) => Math.round(parseFloat(p.score.replace(',', '.')) / parseFloat(p.max) * 100);
---
<div class="rb">
  <p class="rb-t">{t.title}</p>
  <ul>
    {site.platforms.map(p => (
      <li><a href={p.url} rel="noopener" target="_blank" class:list={['rb-c', `rb-${p.id}`]}>
        <span class="rb-h">
          {p.id === 'google' && <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11.8a10 10 0 0 1-4.4 6.6v5.5h7.1c4.2-3.8 6.6-9.5 6.6-16.1z"/><path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.4l-7.1-5.5c-2 1.3-4.5 2.1-7.4 2.1-5.7 0-10.6-3.9-12.3-9H4.4v5.7A22 22 0 0 0 24 46z"/><path fill="#FBBC05" d="M11.7 28.2a13.2 13.2 0 0 1 0-8.4v-5.7H4.4a22 22 0 0 0 0 19.8l7.3-5.7z"/><path fill="#EA4335" d="M24 10.8c3.2 0 6.1 1.1 8.4 3.3l6.3-6.3A22 22 0 0 0 4.4 14.1l7.3 5.7c1.7-5.1 6.6-9 12.3-9z"/></svg>}
          {p.id === 'thefork' && <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="23" fill="#00665C"/><path d="M17 11v12a4 4 0 0 0 3 3.9V37h3V26.9a4 4 0 0 0 3-3.9V11h-2.5v10h-1.5V11h-2v10H18.5V11z" fill="#fff"/><path d="M30 11c3 1 4 5 4 9s-1 6-2.5 6.5V37h-3V11z" fill="#fff"/></svg>}
          <b>{p.name}</b>
        </span>
        <span class="rb-s"><strong dir="ltr">{lang === 'en' ? p.score.replace(',', '.') : p.score}</strong><span>/{p.max}</span></span>{" "}
        {p.id === 'google' && <span class="rb-st" style={`--p:${pct(p)}%`} role="img" aria-label={`${p.score} ${t.outOf} ${p.max}`}>★★★★★</span>}{" "}
        <span class="rb-n">{fmt(p.count)} {t.reviews}</span>
      </a></li>
    ))}
  </ul>
</div>
<style>
  .rb{max-width:720px;margin:0 auto;color:#fff}
  .rb-t{text-align:center;margin:0 0 14px;font:800 .75rem/1 var(--head);letter-spacing:.18em;text-transform:uppercase;color:#f1e3cf}
  .rb ul{display:grid;grid-template-columns:1fr 1fr;gap:12px;list-style:none;margin:0;padding:0}
    .rb-c{display:flex;flex-direction:column;align-items:flex-start;gap:6px;height:100%;padding:18px 16px 16px;border-radius:16px;background:var(--bg);color:var(--fg);text-decoration:none;position:relative;overflow:hidden;transition:transform .15s,box-shadow .15s}
  .rb-google{--bg:#fff;--fg:#202124;--mut:#5f6368;--star:#fbbc04;--off:#dadce0}.rb-thefork{--bg:#8ee05f;--fg:#00473c;--mut:#00473c;--star:#00473c;--off:rgba(0,71,60,.25)}
  .rb-google::before{content:"";position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,#4285f4 0 25%,#ea4335 0 50%,#fbbc05 0 75%,#34a853 0)}
  .rb-c:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.25)}
  .rb-h{display:flex;align-items:center;gap:8px}
  .rb-h svg{width:24px;height:24px;flex:none}
  .rb .rb-h b{font:800 .95rem/1 var(--head);color:var(--fg);text-transform:none;margin:0}
  .rb-s{display:flex;align-items:baseline;gap:2px;margin-top:4px}
  .rb-s strong{font:900 2.6rem/1 var(--head);letter-spacing:-.02em}
  .rb-s span{font:800 1rem/1 var(--head);color:var(--mut)}
  .rb-st{font-size:1.1rem;letter-spacing:2px;line-height:1;background:linear-gradient(90deg,var(--star) var(--p),var(--off) var(--p));-webkit-background-clip:text;background-clip:text;color:transparent}
  .rb-n{font-size:.85rem;color:var(--mut);font-weight:600}
  @media(min-width:700px){.rb-c{padding:20px 22px}.rb-s strong{font-size:3.2rem}}
</style>
