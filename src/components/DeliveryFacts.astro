---
// Bezorgblok op de homepage: kosten, minimale bestelling en bezorggebied.
// TODO-CONTROLEREN: vul bezorgkosten, minimumbedrag en levertijd in bij site.delivery in src/data/site.ts.
// Zolang ze leeg zijn, verwijst het blok naar de bestelwinkel waar de actuele bedragen staan.
import { site } from '../data/site';
const d = site.delivery;
const shop = 'Zie de bestelwinkel';
const facts: [string, string][] = [
  ['Bezorgkosten', d.fee ?? shop],
  ['Minimale bestelling', d.minimum ?? shop],
  ['Bezorggebied', 'Amstelveen en Buitenveldert'],
];
---
<section class="sec dlv"><div class="wrap">
  <div class="head"><div><p class="eyebrow">Bezorgen &amp; afhalen</p><h2>Thuisbezorgd in Amstelveen en Buitenveldert</h2></div></div>
  <dl>{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  <p>Postcodes {d.postcodes}. Afhalen kan aan de {site.street}. <a href="/bezorgen-amstelveen/">Alles over bezorgen</a></p>
  <div class="btns"><a class="btn primary" href={site.orderUrl!} rel="noopener">Bestel online</a></div>
</div></section>
<style>
  .dlv dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:0 0 18px}
  .dlv dl div{background:#fff;border:1px solid #e6dccd;border-radius:14px;padding:16px 18px}
  .dlv dt{font-size:.82rem;color:var(--muted)}
  .dlv dd{margin:4px 0 0;font:800 1.15rem/1.2 var(--head)}
</style>
